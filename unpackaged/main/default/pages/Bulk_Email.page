                    //this method sets header datatype:
                    function chkheaderdatatyp()
                    {
                        try
                        {
                            headertype = new Array();   
                            numberIndex = new Array();
                            boleanData = new Array();
                            getDateTypeColumn = new Array();
                            getDatetimeTypeColumn = new Array();
                            getEmailTypeColumn = new Array();
                            var string = new AW.Formats.String;
                            var number = new AW.Formats.Number;
                            var date = new AW.Formats.Date;

                            number.setTextFormat("#,###.##");
                            date.setDataFormat("ISO8601");
                            date.setTextFormat("mmm d, yyyy");

                            headertype.push(string);

                            for(var j=0; j < reportdatatypes.length; j++)
                            {  
                                if(reportdatatypes[j].trim().toLowerCase().indexOf('boolean') > -1)
                                    boleanData.push(j+1);
                                else if(reportdatatypes[j].trim().toLowerCase().indexOf('string') > -1 || 
                                reportdatatypes[j].trim().toLowerCase().indexOf('id') > -1)
                                {
                                    headertype.push(string);
                                }
                                
                                else if(reportdatatypes[j] == 'date')
                                {
                                    headertype.push(string);                           
                                    getDateTypeColumn.push(j+1);
                                }
                                else if(reportdatatypes[j] == 'datetime')
                                {
                                    headertype.push(date);                           
                                    getDatetimeTypeColumn.push(j+1);
                                }
                                else if(reportdatatypes[j].trim().toLowerCase().indexOf('integer') > -1 ||
                                reportdatatypes[j].trim().toLowerCase().indexOf('double') > -1 ||
                                reportdatatypes[j].trim().toLowerCase().indexOf('currency') > -1 ||
                                reportdatatypes[j].trim().toLowerCase().indexOf('percent') > -1)
                                {
                                    headertype.push(number);
                                    numberIndex.push(j+1);
                                }
                                if(reportdatatypes[j].trim().toLowerCase().indexOf('email') > -1)
                                {
                                    getEmailTypeColumn.push(j+1);
                                }
                                else
                                    headertype.push(string);
                            }
                            return headertype;
                        }
                        catch(ex)
                        {
                            document.getElementById('blurred').style.display = 'none';
                            document.getElementById('iderrordiv').innerHTML=ex;
                            ErrorMessage();
                            return null;                            
                            
                        }
                    }
