<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Dividends</fullName>
    <active>true</active>
    <errorConditionFormula>if(Dividends__c  &lt;0,true,false)</errorConditionFormula>
    <errorDisplayField>Dividends__c</errorDisplayField>
    <errorMessage>Dividends cannot be less than zero.</errorMessage>
</ValidationRule>
