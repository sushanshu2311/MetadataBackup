                /*@Description: Used for view error message for requird field on page.*/
                function viewRequiredfieldError(InputcolumnClass)
                {
                    
                    InputcolumnClass = InputcolumnClass.split(',');
                    var isReqField='';
                    
                    for(var i=0; i<InputcolumnClass.length; i++)
                    {
                        var isReq='';
                        className = InputcolumnClass[i];
                        errorMsgCls ='';
                        
                        if(className.indexOf('true')>0)
                        {
                            var inputval = document.getElementsByClassName(""+className+"")[0].value;
                            errorMsgCls = className+'ErrorMsg';
                            
                            if(inputval.length==0)
                            {
                                document.getElementById(""+errorMsgCls+"").style.display="block";                               
                                document.getElementsByClassName(""+className+"")[0].style.border="2px solid #c23934";
                                if(document.getElementsByClassName(""+className+"")[1]!= null){
                                    document.getElementsByClassName(""+className+"")[1].style.border="2px solid #c23934";
                                }
                                if(document.getElementsByClassName(""+className+"")[2]!= null){
                                    document.getElementsByClassName(""+className+"")[2].style.border="2px solid #c23934";
                                }
                                if(document.getElementsByClassName(""+className+"")[3]!= null){
                                    document.getElementsByClassName(""+className+"")[3].style.border="2px solid #c23934";
                                }
                                if(document.getElementsByClassName(""+className+"")[4]!= null){
                                    document.getElementsByClassName(""+className+"")[4].style.border="2px solid #c23934";
                                }
                                isReq = true;
                            }
                            else
                            {
                                document.getElementById(""+errorMsgCls+"").style.display="none";
                                document.getElementsByClassName(""+className+"")[0].style.borderColor="1px solid #d8dde6";
                                isReq = false;
                            }
                        } 
                        isReqField+= isReq;
                    }
                    return isReqField;
                }
            </script>
