<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Management_Fee</fullName>
    <active>true</active>
    <errorConditionFormula>if( Management_Fee__c &lt;0,true,false)</errorConditionFormula>
    <errorDisplayField>Management_Fee__c</errorDisplayField>
    <errorMessage>Management Fee cannot be less than zero.</errorMessage>
</ValidationRule>
