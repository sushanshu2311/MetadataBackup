            function getFieldValues(fieldApiClass)
            {
                var fieldData = '';
                var tagClass= document.getElementsByClassName(fieldApiClass)[0];
                if(tagClass != null && tagClass != undefined && tagClass != 'undefined')
                {
                    var tagType = tagClass.getAttribute("type");
                    if(tagType == 'checkbox')
                    {
                        if(document.getElementsByClassName(fieldApiClass)[0].checked)
                        {
                            fieldData = 'true'; 
                        }
                        
                        else 
                        {
                            fieldData = 'false';
                        }          
                    }
                    else 
                    {
                        var tagName = tagClass.tagName;
                        if(tagName == 'SELECT')
                        {
                            var SelecOptionsStr = '';
                            var selectListElement = document.getElementsByClassName(fieldApiClass)[0]; // Id of the multi select picklist
                            for(var i=0; i<selectListElement.length; i++) 
                            { 
                                var opt = selectListElement.options[i];
                                if(opt.selected) 
                                {
                                    if(SelecOptionsStr == '')
                                    {
                                        SelecOptionsStr = selectListElement.options[i].text;
                                        if(SelecOptionsStr == '--None--')
                                        {
                                            SelecOptionsStr = '';
                                        }
                                    }
                                    else
                                    {
                                        SelecOptionsStr = SelecOptionsStr + ';' + selectListElement.options[i].text;
                                        
                                    }
                                }
                            }
                            fieldData = SelecOptionsStr;
                            
                        }
                        else if(tagName == 'INPUT')
                        {
                            var parentClassList = tagClass.parentElement.classList.contains('lookupInput');
                            if(parentClassList == true)
                            {
                                var fieldHtmlId = tagClass.getAttribute('id');
                                var lookupDefaultValue = document.getElementById(fieldHtmlId+'_lkid').value;
                                if(lookupDefaultValue != '000000000000000'){
                                    fieldData= lookupDefaultValue;
                                }
                                else
                                {
                                    fieldData= '';
                                }               
                            }
                            
                            else
                            {
                                fieldData = document.getElementsByClassName(fieldApiClass)[0].value;
                            } 
                        }
                            else
                            {
                                fieldData = document.getElementsByClassName(fieldApiClass)[0].value;
                            } 
                        
                    }
                    
                }  
                return fieldData;     
            }
            
