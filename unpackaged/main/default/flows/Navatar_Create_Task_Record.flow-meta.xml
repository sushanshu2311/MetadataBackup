    <formulas>
        <name>RelatedAssoications</name>
        <dataType>String</dataType>
        <expression>IF(
    LEFT({!RelatedAssociationID}, 1) = &quot;[&quot;,
    IF(
        RIGHT({!RelatedAssociationID}, 2) = &quot;,]&quot;,
        MID({!RelatedAssociationID}, 2, LEN({!RelatedAssociationID}) - 3),
        IF(
            RIGHT({!RelatedAssociationID}, 1) = &quot;]&quot;,
            MID({!RelatedAssociationID}, 2, LEN({!RelatedAssociationID}) - 2),
            MID({!RelatedAssociationID}, 2, LEN({!RelatedAssociationID}) - 1)
        )
    ),
    {!RelatedAssociationID}
)</expression>
    </formulas>
