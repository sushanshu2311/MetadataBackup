                            DateTimeIndex = new Array();
                            RefrenceIndex = new Array();
                            Subjectindex = new Array();
                            AccNameindex = new Array();            
                            ConNameindex = new Array();   
                            ConNameMethodCallindex = new Array();  
                            AccNameMethodCallindex = new Array(); 
                            var getcolumn;
                            var getqry;              
                            var queryMore = true;

                            if(fields != null && fields != 'null' && fields != '')
                            {            
                                getSelectedfields = fields;
                            }
                            else
                            {
                                return false;
                            }
                            setHeaderValues();
                            headernames.unshift("");
                            getcolumn = getqueryMain.substring(6,getqueryMain.indexOf('from'));
                            var clumnsplit = getcolumn.split(',');
                             
                            for( var i=0; i<clumnsplit.length; i++)
                            {
                                columnarry.push(clumnsplit[i].trim());
                            } 
                            
                            try
                            {                          
                            var mainqueryresult = sforce.connection.query(getqueryMain); // Main Query
                                
                            }
                            catch(err)
                            {
                                var a= document.getElementById('pageid:frm:textfilt').value;
                                if(a!= '')
                                { 
                                    document.getElementById('filterErrorvalidation').innerHTML= 'Your filter logic is imprecise or incorrect. Please use correct format for<br/> filter logic. e.g.- 1 AND 2 , 1 OR 2, (1 OR 2) AND 3 etc';
                                    document.getElementById('filterErrorvalidation').style.display="block";
                                } 
                                queryMore = false;
                            }
                            
                            var  recordsfinal='';
                            while(queryMore)
                            {
                                var records;       
                                records = mainqueryresult.getArray("records");
                                 
                                recordsfinal=records.length;

                                
                                for(var i=0;i<recordsfinal;i++)
                                {  
                                    var rowVal1 = new Array();

                                    if(selectedConId=='')
                                    {
                                        selectedConId = '\''+ records[i].Id+'\'';
                                    }
                                    else
                                    {
                                        selectedConId =  selectedConId+',\''+records[i].Id+'\'';
                                    }

                                    for(var j=0;j<columnarry.length;j++)
                                    {   
                                        if(columnarry[j].indexOf('.') == -1)
                                        {                               
                                            if(records[i].get(columnarry[j]) != null)
                                            {
                                                if((fieldsDataType[j] != undefined && fieldsDataType[j] != '' && fieldsDataType[j] != null) && (fieldsDataType[j].toLowerCase() == 'currency' || fieldsDataType[j].toLowerCase() =='double'))
                                                    rowVal1.push(parseFloat(records[i].get(columnarry[j]).toString()).toFixed(2));
                                                else
                                                {
                                                    rowVal1.push(records[i].get(columnarry[j]));
                                                }
                                            }
                                            else
                                                rowVal1.push('');
                                        }                              
                                        else
                                        {
                                            var getparentobjname= columnarry[j].substring(0,columnarry[j].indexOf('.'));
                                             
                                            var getparentobjfld= columnarry[j].substring(columnarry[j].indexOf('.')+1,columnarry[j].length);
                                            var getparentobj= records[i].get(getparentobjname);   
                                            
                                            if(getparentobj!= null)
                                            {  
                                                if(getparentobjfld.toLowerCase() ==("Email").toLowerCase())
                                                {
                                                    var getparentobjfldvalue;                                      
                                                    getparentobjfldvalue = getparentobj.get(getparentobjfld);                          

                                                    if(getparentobjfldvalue != null)
                                                    {
                                                        rowVal1.push(getparentobjfldvalue);
                                                    }
                                                    else
                                                        rowVal1.push('');
                                                } 
                                                else if(getparentobjfld.toLowerCase()== ("AccountId").toLowerCase()){ // See from here Contact
                                                    var accID= getparentobj.get(getparentobjfld);
                                                    var getparentobjfldvalue;  
                                                    getparentobjfldvalue= accountMapIdAndName[accID].Name;
                                                    getparentobjfldvalue= '<a title="'+getparentobjfldvalue+'" target="_blank" style="cursor:pointer;" href="/'+accID+'">'+getparentobjfldvalue+'</a>';
                                                    
                                                    if(getparentobjfldvalue != null)
                                                    {
                                                        rowVal1.push(getparentobjfldvalue);
                                                        AccountNameIndex.push(i+1);
                                                    }
                                                    else
                                                        rowVal1.push('');
                                                }
                                                else
                                                {
                                                    var getparentobjfldvalue;                                      
                                                    getparentobjfldvalue = getparentobj.get(getparentobjfld);                          
                                                    
                                                    if(CurrencyIndex.indexOf(j+1) > -1)
                                                    {
                                                        getparentobjfldvalue = getCurrencyValue('{!if(iscurrency==true,'true','false')}','{!JSENCODE(strCurrencySystembol)}',getparentobj,getparentobjfldvalue,LocaleStrings,Namespaceprefix1+'Contact__r');
                                                       
                                                        if(getparentobjfldvalue != 'NaN')
                                                        {
                                                            rowVal1.push(getparentobjfldvalue);
                                                        }
                                                        else
                                                        {
                                                            rowVal1.push('');

                                                        }
                                                    }
                                                    else if(getparentobjfldvalue != null)
                                                    {
                                                        if((fieldsDataType[j] != undefined && fieldsDataType[j] != '' && fieldsDataType[j] != null) && (fieldsDataType[j].toLowerCase() == 'currency' || fieldsDataType[j].toLowerCase() =='double'))
                                                        {
                                                            getparentobjfldvalue = parseFloat(getparentobjfldvalue.toString()).toFixed(2);
                                                        }  
                                                        
                                                        /**9Nov2017 
                                                        var myRegExp = new RegExp('<' ,'gi');
                                                        getparentobjfldvalue = getparentobjfldvalue.replace(myRegExp,'');
                                                        myRegExp = new RegExp('>' ,'gi');
                                                        getparentobjfldvalue = getparentobjfldvalue.replace(myRegExp,'');
                                                        **/
                                                        
                                                        rowVal1.push(getparentobjfldvalue);
                                                    }
                                                    else
                                                    {
                                                        rowVal1.push('');
                                                    }
                                                }

                                            }
                                            else
                                            {
                                                rowVal1.push('');
                                            }             
                                        }                            
                                    }
                                    allcontactrecords.push(rowVal1);
                                }

                                if(mainqueryresult.getBoolean("done"))
                                {                    
                                    queryMore = false;
                                }
                                else
                                {
                                    mainqueryresult = sforce.connection.queryMore(mainqueryresult.queryLocator);   
                                }               
                            }
                            if(parseInt(allcontactrecords.length) < 2000 && chksortlimit == false)
                            {

                            document.getElementById('total_records').innerHTML = parseInt(allcontactrecords.length);
                            document.getElementById('Showallid').style.display = 'none';
                            document.getElementById('countidmain').style.display = 'none';
                            }
                                                    
                            else if(parseInt(allcontactrecords.length) > 1999 && chksortlimit == false)
                            {
                            document.getElementById('Showallid').style.display = 'block';
                            document.getElementById('countidmain').style.display = 'block';
                            document.getElementById('total_records').innerHTML = 1999;
                            }

                            else if(chksortlimit == true)
                            {
                            document.getElementById('total_records').innerHTML = parseInt(allcontactrecords.length);
                            document.getElementById('Showallid').style.display = 'none';
                            document.getElementById('countidmain').style.display = 'none';
                            }
                            document.getElementById('loadprogress').style.display = 'none'; 
                            
                            createdata();
                        }
                        catch(ex)
                        {               
                            alert('Error executeQuery:'+ex);
                        }
                    }

