                    /* Method used to parse data from the response of report analytics*/
                    function DataParsing(dataparse)
                    {      
                    
                        HeaderNames= new Array();
                        var  PrimaryArray=JSON.parse(dataparse);
                        try
                        {
                            if(PrimaryArray[0].errorCode == "BAD_REQUEST")
                            {                                          
                            return null;
                            }                    
                            else if(PrimaryArray[0].errorCode == "NOT_IMPLEMENTED")
                            {                           
                            summarytabular();
                            document.getElementById('loadprogress').style.display = 'none';                     
                            return null;
                            }
                            else
                            {                   
                            document.getElementById('loadprogress').style.display = 'none';                         
                            return null;
                            }
                        }
                        catch(err)
                        {                         
                            document.getElementById('loadprogress').style.display = 'block';
                            PrimaryArray = JSON.parse(dataparse); 
                            Alldata = PrimaryArray.allData; 
                            Dateindex = new Array();
                            legalname=new Array();
                            contactrepid = new Array();
                            emailindex = new Array();
                            lastnames=new Array();                                                 
                            Dataindex = new Array();
                            booleanindex = new Array();
                            Reportdatatypes = new Array();
                            lastnamesfull=new Array();
                            Datetimeindex = new Array();
                            var reportMetadata = PrimaryArray.reportMetadata;
                            ReportFormat = reportMetadata.reportFormat;     
                            if(ReportFormat != 'TABULAR') 
                            {
                                if(ReportFormat != 'SUMMARY')
                                {
                                  document.getElementById('loadprogress').style.display = 'none';                                
                                    summarytabular();                               
                                    return null;
                                }   
                            } 
                            TableColumns = reportMetadata.detailColumns;                    
                            var ExtendedMetaData = PrimaryArray.reportExtendedMetadata.detailColumnInfo;                            
                            for(var avr=0;avr< TableColumns.length;avr++)
                            {                                                 
                                var Columnlabel=ExtendedMetaData[TableColumns[avr]];                                                      
                                if(Columnlabel.label.toLowerCase()=='contact id'|| Columnlabel.label.toLowerCase()=='contact: contact id')
                                {
                                    Contactids='true';
                                    ConApiName=TableColumns[avr];
                                    GetConidColumnnum = avr;
                                }                        
                                if(Columnlabel.dataType!= 'textarea' && Columnlabel.dataType!='encryptedstring')
                                {
                                    HeaderNames.push(Columnlabel.label);
                                    Reportdatatypes.push(Columnlabel.dataType)
                                }                       
                                if(Columnlabel.dataType=='textarea' ){
                                    continue;
                                }
                                else if(Columnlabel.dataType=='encryptedstring'){
                                    continue;
                                }
                                Dataindex.push(avr);                              
                            }  
                            for(var az=0;az<HeaderNames.length;az++)
                            {                            
                               var xx=HeaderNames[az].toLowerCase().split(':')[0];
                               if(xx == accounlabel.toLowerCase()){
                                    accountidrep=az;
                                    legalname.push(az+1);
                                }                           
                                else if(HeaderNames[az].toLowerCase() == contactfirstlabel.toLowerCase()){
                                    contactrepid.push(az+1);
                                }                               
                                else if (emaillabel.indexOf(HeaderNames[az].toLowerCase())>-1){
                                    emailindex.push(az+1);
                                }                           
                                else if(HeaderNames[az].toLowerCase() == contactlastlabel.toLowerCase()){
                                   lastnames.push(az+1);
                                }
                                else if(HeaderNames[az].toLowerCase() == contactfullname.toLowerCase()){
                                   lastnamesfull.push(az+1);
                                }
                                else{}                            
                            }                        
                            if(Contactids=='false')
                            {    
                                ContactIdmissing_popup();
                                ArrayReportData1='';
                                HeaderNames='';
                                if(HeaderNames.indexOf(Sortedcolumn)!=0)
                                Columnno = HeaderNames.indexOf(Sortedcolumn);
                                gridsorting(Columnno,SortOrder);
                                CreateData();
                                document.getElementById('loadprogress').style.display = 'none';                        
                                return null;
                            }                            
                            GetReportRows(PrimaryArray);                   
                        }           
                    }

