                    function loadPopupnew(cid1,cid2)
                    {
                        if(popupStatus==0){
                            $('.'+cid1).css({
                            "opacity": "0.5"
                            });
                            $('.'+cid1).fadeIn("slow");
                            $('.'+cid2).fadeIn("slow");
                            popupStatus = 1;
                        }
                    };
                    
                    function centerPopupnew(cid)
                    {
                        //request data for centering
                        var windowWidth = document.documentElement.clientWidth;
                        var windowHeight = document.documentElement.clientHeight;
                        var popupHeight = $('.'+cid).height();
                        var popupWidth = $('.'+cid).width();
                        //centering
                        $('.'+cid).css({
                            "position": "fixed",
                            "top": windowHeight/2-popupHeight/2,
                            "left": windowWidth/2-popupWidth/2
                        });
                    };
                                        
                    /*
                    @Description: Executes for an onkeyup event of static fields, for both Left & Right panel.
                    @Parameter: Passing this, which includes value, id & all attributes of clicked event.
                    */
                    function fixedFieldsFun( thisIs ) 
                    {       
                        /*Dynamic Fields*/                  
                        var vall = document.getElementById(thisIs.id).value;                    
                        var strid = thisIs.id;
                                             
                        if(document.getElementById(thisIs.id).value == '' && strid.indexOf("dealinputleftcolmn")>-1)
                        {
                            jQuery('#'+thisIs.id).removeClass( "icon_33LightPipeline" ).removeClass( "icon_33LightAccount" );
                        }
                        
                        if(document.getElementById(thisIs.id).value == '' && strid.indexOf("dealinputrightcolmn")>-1)
                        {
                            jQuery('#'+thisIs.id).removeClass( "icon_33LightPipeline" ).removeClass( "icon_33LightAccount" );
                        }
                        
                        if(document.getElementById(thisIs.id).value == '' && strid.indexOf("accinputleftcolmn")>-1)
                        {
                            jQuery('#'+thisIs.id).removeClass( "icon_33LightAccount" );
                        }
                        
                        if(document.getElementById(thisIs.id).value == '' && strid.indexOf("coninputleftcolmn")>-1)
                        {
                            jQuery('#'+thisIs.id).removeClass( "icon_33LightContact" );
                        }
                        
                    }       
                                    
                </script>
