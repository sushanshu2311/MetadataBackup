            var tempName='';
            function checkmassmail()
            {
                
                try
                {
                   document.getElementById('blurred').style.display='block';
                   var RemainingEmailLimit=0; 
                   var Namespaceprefix1 = '{!JSENCODE(NameSpacePrefix)}';  // SK: 11Dec2017
                                   
                 
                       try
                       {
                            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.MassEmailFundraising.GetEmailLimit}',function(result, event)
                            {                                                    
                               if(event.status)
                               {  
                                                             
                                    var limtresult="";                          
                                    limtresult=result.replace(/\&lt\;/g,'<').replace(/\&lt\;/g,'<').replace(/\&gt\;/g,'>').replace(/\&amp\;/g,'&').replace(/&#39;/g, "'").replace(/\&quot\;/g, '"');                
                                    
                                    var Maildata=JSON.parse(limtresult);                                   
                                    RemainingEmailLimit=Maildata['SingleEmail'].Remaining;                          
                                   
                                    if(parseInt(RemainingEmailLimit) <= 0)
                                    {
                                        document.getElementById('blurred').style.display = 'none';    
