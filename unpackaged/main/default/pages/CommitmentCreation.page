            function gettingAllRequiredFields(describeLayout,layoutObjectName)
            {
                var recordTypeId = '{!JSENCODE(strLimitedPartnerRecordTypeId)}';
                var layoutSelectId='';
                
                var layoutRecordTypes = describeLayout.getArray('recordTypeMappings');
                for(var l=0; l<layoutRecordTypes.length; l++)
                { 
                    if((recordTypeId != '' && recordTypeId != null) && layoutObjectName =='Account')
                    {
                        if(layoutRecordTypes[l].recordTypeId == recordTypeId)
                        {
                            layoutSelectId = layoutRecordTypes[l].layoutId;
                        }                  
                        
                    }
                    else
                    {
                        var isLayoutDefault = layoutRecordTypes[l].defaultRecordTypeMapping;
                        if(isLayoutDefault == 'true' || isLayoutDefault == true)
                        {
                            layoutSelectId = layoutRecordTypes[l].layoutId;
                        }
                    }  
                }
                gettingAllRequiredFieldApiName(describeLayout,layoutSelectId,layoutObjectName);     
                
            }
            
            
            function gettingAllRequiredFieldApiName(describeLayoutResult,layoutId,layoutObject)
            { 
             if(layoutObject == 'Account')          
                 arrayLimitedPartnerRequired = [];
             else if(layoutObject == 'Commitment')   
                 arrayCommitmentRequired = [];
             else if(layoutObject == 'Partnership')
                arrayPartnershipRequired = [];
             var objectLayouts= describeLayoutResult.getArray('layouts');
             for(var i=0; i<objectLayouts.length; i++)
             {
                 if(objectLayouts[i].id == layoutId)
                 {
                     var objectEditLayouts = objectLayouts[i].getArray('editLayoutSections');
                     for(var k=0; k<objectEditLayouts.length; k++)
                     {
                         var objectLayoutRows = objectEditLayouts[k].getArray('layoutRows');
                         for(var j=0; j<objectLayoutRows.length; j++)
                         {
                             var objectLayoutLines = objectLayoutRows[j].getArray('layoutItems');
                             for(var q=0; q<objectLayoutLines.length; q++)
                             {
                                 if(objectLayoutLines[q].required == 'true')
                                 {
                                     var objectLayoutComponents = objectLayoutLines[q].getArray('layoutComponents');
                                     for(var p =0; p<objectLayoutComponents.length; p++)
                                     {
                                         var fieldsApiNames =objectLayoutComponents[p].value; 
                                         if(layoutObject =='Account')
                                         {
                                             
                                             arrayLimitedPartnerRequired.push(fieldsApiNames.toLowerCase());
                                         }
                                         else if(layoutObject =='Commitment')
                                         {
                                             arrayCommitmentRequired.push(fieldsApiNames.toLowerCase());
                                             
                                         }
                                             else if(layoutObject =='Partnership')
                                             {
                                                 arrayPartnershipRequired.push(fieldsApiNames.toLowerCase());
                                                 
                                             }                               
                                     }
                                 }
                             }
                             
                         }          
                         
                     }
                     
                     
                 }
                 
             }
            }
            
            
            
