                                aoption.options.add(new Option('not equal to', '!='));
                                aoption.options.add(new Option('includes', 'includes'));
                                aoption.options.add(new Option('excludes', 'excludes'));
                            } else if (Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'DOUBLE' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'INT' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'INTEGER' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'CURRENCY' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'PERCENT' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'DATETIME' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'DATE') { // for DATE,DATETIME,PERCENT,CURRENCY,INTEGER,DOUBLE
                                aoption.options.add(new Option('equals', '='));
                                aoption.options.add(new Option('not equal to', '!='));
                                aoption.options.add(new Option('less than', '<'));
                                aoption.options.add(new Option('greater than', '>'));
                                aoption.options.add(new Option('less or equal', '<='));
                                aoption.options.add(new Option('greater or equal', '>='));
