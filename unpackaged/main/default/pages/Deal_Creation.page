                                    if(sourcePopupRequiredField.length==0){
                                        sourcePopupRequiredField = strRequiredFeild;
                                    }else{
                                        sourcePopupRequiredField = sourcePopupRequiredField+','+strRequiredFeild;
                                    }                               
                                }else{
                                    strRequiredFeild = gerRequiredFeildsOnPageLayout(''+objname+'' ,recordtype_id);   //get required fields from sobject layout               
                                    strRequiredFeild = strRequiredFeild.toString();
                                    strRequiredFeild = strRequiredFeild.substring(0,strRequiredFeild.length-1);                  
                                    if(arrObjRequiredFeild.length==0){
                                        arrObjRequiredFeild = strRequiredFeild;
                                    }else{                      
                                        arrObjRequiredFeild = arrObjRequiredFeild+','+strRequiredFeild;                 
