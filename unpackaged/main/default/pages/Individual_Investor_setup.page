            /*@Description: This method will execute on Click of Save button.*/
            function saveIISetup()
            {
              
                document.getElementById('loadingDiv').style.display = '';
                var APIsOfSelectedValues = [];              /*Hold API names of selected values.*/  
                var mapFieldIndexVsValueLft = {};           /*Map to hold all left values against the index as a key.*/
                var mapFieldIndexVsValueRyt = {};           /*Map to hold all right values against the index as a key.*/
                var finalStringB4Save='';                   /*Final string just before save.*/
                var finalStringB4SaveLft='';                /*Final string for left panel.*/
                var finalStringB4SaveRyt='';                /*Final string for right panel*/
                arrOfIndexLft = [];                         
                arrOfIndexRyt = [];                         
                var isShowErr = false;                      /*Show Duplicate error.*/
                var count = 0;                              /*Count of multiple values to show error of duplicay.*/
                /*@Logic: Get API names of selected values*/
                for(var i = 0; i < arrIdVsName.length; i++) 
                {
                    var arrVal = arrIdVsName[i].substring( arrIdVsName[i].indexOf('#¤#') + 3, arrIdVsName[i].length );
                    var arrValId = arrIdVsName[i].substring( 0, arrIdVsName[i].indexOf('#¤#') + 3 );
                    var arrValIndex = arrIdVsName[i].substring( 9, arrIdVsName[i].indexOf('#¤#'));
                    if( arrValId.indexOf('hitFirstt') > -1 || arrValId.indexOf('HitSecondd') > -1 )
                        arrValIndex = '0';
                        var fieldId = arrValId.split('#¤#').join('');
                        var inputFieldValue = document.getElementById(fieldId).value;
                        if(inputFieldValue != '' && inputFieldValue != null)
                          {
                            <apex:repeat value="{!FieldLabelVsApi}" var="lst"> 
                            if('{!JSENCODE(FieldLabelVsApi[lst])}' == arrVal)
                            {
