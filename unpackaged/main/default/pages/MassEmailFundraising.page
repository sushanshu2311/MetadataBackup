            /*
             *This function is used for searching contacts present in the contacts grid when the enter key is pressed inside the input search box
             *@ e Represents the Event object                     
            */
            function getEnterEvent(e)
            {   
                try
                {                  
                    if(e.keyCode == 13)
                    {        
                        gridSearchfilter();                  
                        document.getElementById('clearsearchdsb').style.display = 'block';
                    }
                    else if(e.keyCode ==8 || e.keyCode ==46)
                    {
                       var value = document.getElementById('searchcon_grid').value.toLowerCase();   
                       if(value!="")
                       {                      
                            document.getElementById('clearsearchdsb').style.display = 'block';
                       }
                       else if(value=="")
                       {                      
                            document.getElementById('clearsearchdsb').style.display = 'none';              
                            allcontactrecords.length=0;
                            checkboxArrayNew.length=0;
                            checkarray.length=0;
                            count=0;                    
                            whereSearch = '';
                            onLoading();
                            
                           // finalfiltr=new Array();
                            mainSearchfilter_new();
                            document.getElementById('searchcon_grid').placeholder = 'Search'; 
                        }
                    }               
                    else if(document.getElementById('searchcon_grid').value!='')
                    {
                        if(e.keyCode!=8)
                        {                     
                            document.getElementById('clearsearchdsb').style.display = 'block';
                        }
                    }           
                    
                }
                catch(err)
                {
                    if(err.faultcode == 'sf:INVALID_SESSION_ID'  )
                    {
                        document.getElementById('blurred').style.display = 'none';
                        document.getElementById('iderrordiv').innerHTML=err; 
                        ErrorMessage();
                    }
                    else
                    {
                        document.getElementById('blurred').style.display = 'none';
                        document.getElementById('iderrordiv').innerHTML=err; 
                        ErrorMessage();
                    }
                  
                }
            }
                   
