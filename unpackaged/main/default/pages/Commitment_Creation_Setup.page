        <script>
            function InsufficientPermissions_Fancybox() 
            {
              loadPopupnew('fancybox_background','InsufficientPermissions_Fancybox');
              centerPopupnew('InsufficientPermissions_Fancybox');
            }

            function Warning_Fancybox() 
