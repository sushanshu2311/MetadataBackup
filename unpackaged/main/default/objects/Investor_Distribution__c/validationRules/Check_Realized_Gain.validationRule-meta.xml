<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Realized_Gain</fullName>
    <active>true</active>
    <errorConditionFormula>if(Realized_Gain__c  &lt;0,true,false)</errorConditionFormula>
    <errorDisplayField>Realized_Gain__c</errorDisplayField>
    <errorMessage>Realized Gain cannot be less than zero.</errorMessage>
</ValidationRule>
