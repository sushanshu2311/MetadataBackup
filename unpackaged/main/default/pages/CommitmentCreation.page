            function checkMadetoryFieldsData(rowSelectValue,objectName,rowSelectId)
            { 
                var RequireFieldBlank = false;
                var arrayOfFieldsRequiredFields = [];
                var fieldErrorId ='';
                var classSufix = '';
                if(objectName == 'Account')
                {
                    arrayOfFieldsRequiredFields = arrayLimitedPartnerRequired;
                    fieldErrorId = 'LPPopUpError';
                    classSufix = 'lp';
                    clearAllErrorMsg('LimitedPartner_Fancybox');        
                }
                else if(objectName == 'Partnership')
                {
                    arrayOfFieldsRequiredFields = arrayPartnershipRequired;
                    fieldErrorId = 'PTPopUpError';
                    classSufix = 'pt';
                    clearAllErrorMsg('NewPartnership_Fancybox');
                }
                    else if(objectName == 'Commitment')
                    { 
                        gettingAllRequiredFields(resultCommitment,'Commitment');
                        arrayOfFieldsRequiredFields = arrayCommitmentRequired;
                        fieldErrorId = 'CommError';
                        classSufix = '';
                        clearAllErrorMsg('AdditionalInfoClass');
                    }
                for(var i=0;i<arrayOfFieldsRequiredFields.length;i++)
                {
                    var fieldApiId = arrayOfFieldsRequiredFields[i];
                    if(fieldApiId != '' && fieldApiId != null)
                    {
                        var LPFieldData = document.getElementsByClassName(classSufix+fieldApiId);
                        if(LPFieldData.length >0)
                        {
                            for(var j=0;j<LPFieldData.length;j++)
                            {
                                var lpFiledData = getFieldValues(classSufix+fieldApiId);
                                var fieldErrorFullId = fieldErrorId+fieldApiId;             
                                if(lpFiledData.trim() == '')
                                {
                                    LPFieldData[j].classList.add('inputValidationClass');
                                    document.getElementById(fieldErrorFullId).style.display = 'block';
                                    RequireFieldBlank = true;
                                    
                                }
                                else
                                {
                                    
                                    document.getElementById(fieldErrorFullId).style.display = 'none';
                                }
                            }  
                        }   }
                }
                if(!RequireFieldBlank && objectName == 'Account')
                    CheckFieldsDataLP(rowSelectValue,rowSelectId); 
                else if(!RequireFieldBlank && objectName == 'Partnership')
                    CheckFieldsDataPT(rowSelectValue,rowSelectId);
                    else if(RequireFieldBlank && objectName == 'Commitment')
                        isErrorDisplay = true;
                
            }
            
            function CloseEditPopup(popupName,selectedRow)
            {
                if(popupName =='LimitedPartner')
                {
                    clearMandetoryMessage('LimitedPartner',selectedRow);
                    
                } 
                else if(popupName =='Partnership') 
                {
                    clearMandetoryMessage('Partnership',selectedRow);
                    
                }
                $('.datePicker').css("position","absolute");           
                closepopup('fancybox_background','FancyboxContainer');
                
            }
            
            
            function clearMandetoryMessage(popupDivName,rowSelectedId)
            {
                var classSufix = '';
                var arrayRequiredFieldBlank={};
                var inputBoxSpecifix='';
                var popupObjectName = '';
                if(popupDivName == 'LimitedPartner')
                {
                    arrayOfFieldsRequiredFields = arrayLimitedPartnerRequired;
                    fieldErrorId = 'LPPopUpError';
                    classSufix = 'lp';
                    popupObjectName = 'Account';
                    inputBoxSpecifix = "LPInput";
                }
                else if(popupDivName == 'Partnership')
                {
                    arrayOfFieldsRequiredFields = arrayPartnershipRequired;
                    fieldErrorId = 'PTPopUpError';
                    classSufix = 'pt';
                    popupObjectName = 'Partnership';
                    inputBoxSpecifix = "PTInput";
                }
                requiredFieldApiName = [];
                for(var i=0;i<arrayOfFieldsRequiredFields.length;i++)
                {
                    var fieldApiId = arrayOfFieldsRequiredFields[i];
                    if(fieldApiId != '' && fieldApiId != null)
                    {
                        var LPFieldData = document.getElementsByClassName(classSufix+fieldApiId);
                        if(LPFieldData.length >0)
                        {
                            requiredFieldApiName.push(fieldApiId);
                            
                        }   
                    }
                }
                var fieldValue = document.getElementsByClassName(inputBoxSpecifix+rowSelectedId);
                if(fieldValue[0].value != null )
