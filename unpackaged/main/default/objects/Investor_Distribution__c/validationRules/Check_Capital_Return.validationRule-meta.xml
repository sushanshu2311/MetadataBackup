<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Capital_Return</fullName>
    <active>true</active>
    <errorConditionFormula>if(Capital_Return__c &lt;0,true,false)</errorConditionFormula>
    <errorDisplayField>Capital_Return__c</errorDisplayField>
    <errorMessage>Capital Return cannot be less than zero.</errorMessage>
</ValidationRule>
