        /*
            @Description: Its a Utility function which create dynamic input element with dynamic Names in the name attribute of Input Text box, when user clicks on Add row icon.
            @Parameter: Recieve dynamic Names (Name of input text) as parameter, and create complete element on the event of AddRows icon.
        */
        function jQueryUtilityOfAutoComplete(nameIs)
        { 
            var getLocalId='';
            j$(document).ready(function()
            {
                $("input[name^='"+nameIs+"']").autocomplete({
                    minLength: 0,
                    source: apexAccountList,
                              
                    focus: function( event, ui )
                    {
                      if(event.keyCode ==38 || event.keyCode ==40 || event.keyCode ==13)
                       {
                        var showSelected = ui.item.value;
                        var labell = ui.item.label;
                        $(this).each(function() 
                        {
                            $.each(this.attributes, function() 
                            {
                                if(this.name == 'id')    /*It will give you the value of clicked input text fields.*/
                                    getLocalId = this.value;
                            });
                        });
                        if(showSelected.indexOf(strContactLabel+':') > -1)
                        {
                            selectedValueAtLast = showSelected.substring(showSelected.indexOf(strContactLabel+':')+strContactLabel.length+1, showSelected.length);
                            jQuery('#'+getLocalId).removeClass( "icon_33LightAcc" ).addClass( "icon_33LightCon" );
                            ui.item.value = selectedValueAtLast;
                        }
