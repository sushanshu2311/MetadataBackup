                        else
                            finalStringB4SaveRyt =  finalStringB4SaveRyt + ',' + mapFieldIndexVsValueRyt[ arrForFinalInsertRight[i] ];
                    }
                }
                
                /*@Logic to check Duplicate API Names before save.*/
                var sorted_arr = APIsOfSelectedValues.slice().sort(); 
                var results = [];
                for (var i = 0; i < APIsOfSelectedValues.length - 1; i++) 
                {
                    if (sorted_arr[i + 1] == sorted_arr[i]) {
                        results.push(sorted_arr[i]);
                    }
                }
                /*Execute if duplicate value found.*/
                if( results.length > 0 )
                {
                    document.getElementById('duplicateErr').style.display = 'block';
                    document.getElementById('blurred').style.display = 'block';
                    document.getElementById('loadingDiv').style.display = 'none';
                }
                else /*get Api name and save in backend*/
                {
                    finalStringB4Save = finalStringB4SaveLft + ';' + finalStringB4SaveRyt;
                    saveIISetupAF(finalStringB4Save)
                }
            }
            
            /*@Description: This method is use to sort the Array(Integers), which is passed as a parameter; Insertion Sort. */
            function insertionSort(unsortedList) 
            {
                var len = unsortedList.length;
                for(var i = 0; i < len; i++) 
                {
                    var tmp = unsortedList[i];
                    for(var j = i - 1; j >= 0 && (unsortedList[j] > tmp); j--) 
                        unsortedList[j+1] = unsortedList[j];
                    unsortedList[j+1] = tmp;
                }
            }
        
