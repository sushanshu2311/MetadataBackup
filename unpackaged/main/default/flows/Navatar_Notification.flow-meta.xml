<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>apex_call_to_publish_platform_event</name>
        <label>apex call to publish platform event</label>
        <locationX>1546</locationX>
        <locationY>294</locationY>
        <actionName>NavatarEventReminderCtrl</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>eventRecords</name>
            <value>
                <elementReference>EventRecord</elementReference>
            </value>
        </inputParameters>
        <nameSegment>NavatarEventReminderCtrl</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Update_Event_Records</name>
        <label>Update Event Records</label>
        <locationX>797</locationX>
        <locationY>709</locationY>
        <actionName>NavatarNotificationEventCheckCtrl</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>ids</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>NavatarNotificationEventCheckCtrl</nameSegment>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Event_assignment</name>
        <label>Event assignment</label>
        <locationX>1404</locationX>
        <locationY>56</locationY>
        <assignmentItems>
            <assignToReference>EventRecord</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>apex_call_to_publish_platform_event</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>check_All_Day_Event</name>
        <label>check All Day Event</label>
        <locationX>233</locationX>
        <locationY>440</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_All_Day_Event</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsAllDayEvent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>CreatedDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Event_Records</targetReference>
            </connector>
            <label>Is All Day Event</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_All_Day_Event_or_Not</name>
        <label>Check All Day Event  or Not</label>
        <locationX>1242</locationX>
        <locationY>443</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_not_All_Day_Event</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsAllDayEvent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.EndDateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Event_Records</targetReference>
            </connector>
            <label>If not All Day Event</label>
        </rules>
    </decisions>
    <description>This flow is created be Priyank for fire custom notification based on event end dates</description>
    <environments>Default</environments>
    <formulas>
        <name>CreatedDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.CreatedDate})</expression>
    </formulas>
    <interviewLabel>Navatar Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Navatar Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>468</locationX>
        <locationY>15</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EndDateTime</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Event</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>All_Day_Event_End</name>
            <connector>
                <targetReference>check_All_Day_Event</targetReference>
            </connector>
            <label>All Day Event End</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>EndDateTime</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Other_Event_Ended</name>
            <connector>
                <targetReference>Check_All_Day_Event_or_Not</targetReference>
            </connector>
            <label>Other Event Ended</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>EndDateTime</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Start_Event_Track</name>
            <connector>
                <targetReference>Event_assignment</targetReference>
            </connector>
            <label>Start Event Track</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>StartDateTime</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>EventRecord</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Event</objectType>
    </variables>
    <variables>
