                if(direction=='Top')
                {                      
                    newPos = SlectedIndex-1;
                    var value = localSltArray{!componentID}[SlectedIndex];
                    localSltArray{!componentID}.splice( SlectedIndex,1 );
                    if("{!UsingPageName}" == "ICG" && SlectedIndex == 1){
                        newPos = newPos+1;
                    }
                    localSltArray{!componentID}.splice(newPos,0,value);            
                }
                else
                {  
                    newPos = SlectedIndex+1;
                    var value = localSltArray{!componentID}[SlectedIndex];
                    localSltArray{!componentID}.splice( SlectedIndex,1 );
                    localSltArray{!componentID}.splice(newPos,0,value);   
                }        
                createSeltList{!componentID}(localSltArray{!componentID});       

                // change seleted css.
                comboSltobj{!componentID}.setSelectedItems(newPos);
                $('#sellist{!componentID}-item-'+newPos).removeClass('aw-items-normal');
                $('#sellist{!componentID}-item-'+newPos).addClass('aw-items-selected');
                
                //enablebuttonsotherdetailselectlist(0,0,0); 
                checkForRestoreButton{!componentID}();
            }
            catch(err){             
               alert('moveUp_Down  '+err);
            }
        }
        
