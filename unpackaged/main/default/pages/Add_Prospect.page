                                       try{                                           
                                           document.getElementById('loadprogress').style.display = 'block';
                                           var Clsresult=result.replace(/&#39;/g, "'").replace(/\&quot\;/g, '"').replace(/\&lt\;/g,'<').replace(/\&lt\;/g,'<').replace(/\&gt\;/g,'>').replace(/\&amp\;/g,'&');                     
                                           DataParsing(Clsresult); 
                                        }
                                        catch(err){
                                            reportErrors_PopUp_error();                           
                                            document.getElementById('loadprogress').style.display = 'none';
                                        }
                                    }
                                    else if(event.type == 'exception'){
                                    
                                    document.getElementById('showoutput').style.display = 'block';
                                    document.getElementById('erroreport').innerHTML = 'Error:'+event.message;
                                    document.getElementById('loadprogress').style.display = 'none';
                                    return null;
                                    }
                                    
                            }, 
                            {escape: true});           
                            
                            }
                            catch(err)
