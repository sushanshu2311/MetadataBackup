        function ColumnstoDisplay_Fancybox{!componentID}() 
        {   
            if("{!UsingPageName}" == "CMF_PFC" || "{!UsingPageName}" == "CMF_PFA")
            {
                closepopup('fancybox_background','FancyboxContainer');
            }
            loadPopupnew{!componentID}('fancybox_background','ColumnstoDisplay_Fancybox{!componentID}');
            centerPopupnew{!componentID}('ColumnstoDisplay_Fancybox{!componentID}');
        }
        /*function closepopup(bgdivid,popupdivid)
        {
            disablePopupnew(bgdivid);
            $('.'+popupdivid).fadeOut("slow");
        }
        function disablePopupnew(cid){
            if(popupStatus==1){
                $('.'+cid).fadeOut("slow");
                popupStatus = 0;
            }   
            
        };*/
        function loadPopupnew{!componentID}(cid1,cid2)
        {
            if(popupStatus==0){
                $('.'+cid1).css({
                    "opacity": "0.5"
                });
                $('.'+cid1).fadeIn("slow");
                $('.'+cid2).fadeIn("slow");
                popupStatus= 1;
            }
        };
        function centerPopupnew{!componentID}(cid)
        {
            //request data for centering
            var windowWidth = document.documentElement.clientWidth;
            var windowHeight = document.documentElement.clientHeight;
            var popupHeight = $('.'+cid).height();
            var popupWidth = $('.'+cid).width();
            //centering
            $('.'+cid).css({
                "position": "fixed",
                "top": windowHeight/2-popupHeight/2,
                "left": windowWidth/2-popupWidth/2
            });
        };
        function blnkSearch(obj)
        {
            document.getElementById('searchcon_grid1{!componentID}').value='';
