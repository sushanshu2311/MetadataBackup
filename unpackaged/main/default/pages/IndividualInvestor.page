                function pageLoadOnComplete()
                {
                    var accessControl = {!if(isIICreation == true, 'true', 'false')};  // SK: 11Dec2017
                    if(accessControl == 'false' || accessControl == false)
                    {
                        accessControlFancyBox();
                        document.getElementById('accessControl').style.display = 'block';
