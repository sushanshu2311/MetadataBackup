    //Used for view error message for requird field on source contact.
    function viewSourceContRequiredfield(){
        inputValue = '';  
        isSourcePopupReqFieldBlank = false;        
         
        inputValue = document.getElementById("thePage:theForm:sourceContId").value; 
        mapSourceContactPopupValue["thePage:theForm:sourceContId"] = ""+inputValue+"";        
        isSourcePopupReqFieldBlank = viewRequiredfieldError(arrsContColumInputClass);
                        
        var contInputcolumnClass =  arrsContColumInputClass.split(',');
        for(var k=0; k<contInputcolumnClass.length; k++){       
        
            if(contInputcolumnClass[k].length>0){
                
                if(MapFieldType[""+contInputcolumnClass[k]+""]!=null && MapFieldType[""+contInputcolumnClass[k]+""]=='MULTIPICKLIST'){
                    
                    var selectList = document.getElementsByClassName(contInputcolumnClass[k])[0];
                    var selectOptions = selectList.getElementsByTagName('option');
                    var strSelectedValue = '';
                    
                    for(var i = 0; i < selectOptions.length; i++)
                    {
                        var opt = selectOptions[i];
                        if(opt.selected)
                        {                       
                            selectList.options[i].selected = true;  
                            strSelectedValue = strSelectedValue + opt.value;
                        }
                    }
                    mapMultipicklistValue[""+contInputcolumnClass[k]+""] = ""+strSelectedValue+"";
                    
                }else{              
                    var contInputColmVal = document.getElementsByClassName(""+contInputcolumnClass[k]+"")[0].value;
                    var contInputColmVal2 = document.getElementsByClassName(""+contInputcolumnClass[k]+"")[0];
                    
                    mapSourceContactPopupValue[""+contInputcolumnClass[k]+""] = ""+contInputColmVal+"";
                    if(contInputColmVal.length>0){
                        var contLookupFieldValue = getSelectedOptions(contInputColmVal2);
                        if(contLookupFieldValue.length>0)
                            mapSourceContactPopupValue[""+contInputcolumnClass[k]+""] = ""+contLookupFieldValue+"";
                    }
                }
            }  
        } 
        return isSourcePopupReqFieldBlank;
    }
            
