                     /*Method to check for marketing prospect check*/ 
                    function CheckingMarketing_prospect()
                    {
                        try
                        {                       
                            var CheckMarketProspectarray = new Array();
                            var result = sforce.connection.describeSObject(Namespaceprefix1 + "Marketing_Prospect__c");                            
                            for (var i = 0; i < result.fields.length; i++) 
                            {
                                var Field = result.fields[i];
                                if (Field.type == 'reference') 
                                {
                                CheckMarketProspectarray.push(Field.name);
                                } 
                                else if (Field.type != 'textarea') 
                                {
                                CheckMarketProspectarray.push(Field.name);
                                } 
                                else if (Field.type == 'textarea' && Field.length <= 255) 
                                {
                                CheckMarketProspectarray.push(Field.name);
                                }
                            }
                            var Mandatoryfields = [Namespaceprefix1+'Account_Name__c',Namespaceprefix1+'Contact__c',Namespaceprefix1+'Marketing_Initiative__c'];
                            for(var j=0 ; j< Mandatoryfields.length ; j++)
                            {
                                if(CheckMarketProspectarray.indexOf(Mandatoryfields[j]) == -1){                                
                                    Insufficient_Privilege();
                                    newUrl = '/'+'{!JSENCODE(propId)}';
                                    location.href = newUrl;
                                }
                            }                        
                        }
                        catch(ex)
                        {                       
                           sessionError(ex);
                        }
                    }
