                    /* Method used to parse data from the response of report analytics*/
                    function DataParsingfunc(dataparse)
                    { 
                    
                        var PrimaryArray1=JSON.parse(dataparse);
                        try
                        {
                            if(PrimaryArray1[0].errorCode == "BAD_REQUEST")
                            {
                                document.getElementById('onethousand').innerHTML=PrimaryArray1[0].message
