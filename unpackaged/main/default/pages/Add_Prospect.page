                            var textBoxid = 'criteriatextBoxMP' + picklistnumber;
                            var elSel = document.getElementById(Operatorpicklist_id);
                            if (Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'PICKLIST' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'BOOLEAN' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'MULTIPICKLISTPICKLIST' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'REFERENCE') //|| Picklistvaluearray[Picklistarraylength1-1].toUpperCase() == 'MULTIPICKLIST'
                            {
                                document.getElementById(Calendericon_id).style.display = 'none';
                                document.getElementById(Lookupicon_id).style.display = 'inline';
                            } 
                            else if (Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'DATETIME' || Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'DATE') {
                                document.getElementById(Lookupicon_id).style.display = 'none';
                                document.getElementById(Calendericon_id).style.display = 'inline';
                            } else {
                                document.getElementById(Calendericon_id).style.display = 'none';
                                document.getElementById(Lookupicon_id).style.display = 'none';
                            }
                            var i;
                            for (i = elSel.length - 1; i >= 0; i--) {
                                elSel.remove(i); // to remove all added options
                            }
                            var aoption = document.getElementById(Operatorpicklist_id);
                            if (Picklistvaluearray[Picklistarraylength1 - 1].toUpperCase() == 'BOOLEAN') { // for BOOLEAN and REFERENCE                             
