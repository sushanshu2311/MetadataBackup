            function evaluateTotal(Obj)
            {
                var tempID = Obj.id;
                tempID = tempID.substring(0,tempID.length-3);
                Obj.value = removeSpace(Obj.value);
                
                if(Obj.value == null || Obj.value == '')
                    Obj.value = '0.000';
                else if(isNaN(Obj.value)){}
                    else
                        Obj.value = ((parseFloat(Obj.value, 10) + 1.00).toFixed(3) - 1.00).toFixed(3);  
                //alert(tempID);
                var capAmountVal = document.getElementById(tempID+"cCC").value;
