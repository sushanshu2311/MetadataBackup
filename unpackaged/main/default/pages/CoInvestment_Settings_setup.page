            var showConInstmntError = '{!if(showConInstmntError==true,'true','false')}';
            function CheckOnComplete()
            {
                /*When checkbox is true only then show error.*/
                if(document.getElementById('thePage:theForm:lookupIdFundComError') == null){
                    if( showConInstmntError == 'false' && ((yesBlank == 'true' && boolChckBoxVal ==  'false') || (yesBlank == 'false' && boolChckBoxVal ==  'false') || (yesBlank == 'false' && boolChckBoxVal ==  'true')) ){
                        
                        window.location.reload();
                    }
                    
                    else if( yesBlank == 'true' && boolChckBoxVal ==  'true' )
                    {
                        document.getElementById('err').style.display = '';
                        document.getElementById('errConInvstmnt').style.display = 'none';
                    }
                    else if(showConInstmntError == 'true')
                    {
                        document.getElementById('errConInvstmnt').style.display = '';
                        document.getElementById('err').style.display = 'none';
                    }
