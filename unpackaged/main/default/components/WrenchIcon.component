        function createSeltList{!componentID}(SelectedFields)
        {
            try
            {
            comboSltobj{!componentID} = new AW.UI.List;
            for(i=0;i<SelectedFields.length;i++)
             {      
                    comboSltobj{!componentID}.setItemImage(SelectedFields[i][0],i);
                    comboSltobj{!componentID}.setItemValue(SelectedFields[i][1],i);
                    /*if(SelectedFields[i][2] == 'Record Type ID'){
                        comboSltobj.setItemText('Record Type',i);
                    }*/
                    
                    if(SelectedFields[i][2] == 'Full Name' && ("{!UsingPageName}" == "MEP" || "{!UsingPageName}" == "AP")){
                        comboSltobj{!componentID}.setItemText('Contact Name',i);
                        //alert('comboSltobj{!componentID}.getItemValue(selectedIndex)' +(comboSltobj{!componentID}.getItemValue(i)));
                    }
                    /* Rajnish 06oct
                    else if((SelectedFields[i][2] == 'Account Name' || SelectedFields[i][2] == 'Legal Name') && "{!UsingPageName}" == "MEF")
                    {
                       // comboSltobj{!componentID}.setItemText('Institution',i); 30 Aug Chnage
                       comboSltobj{!componentID}.setItemText('Account',i); //change According to review 
                    }
                    Rajnish 06oct */
                    //************Change Fundraising Contact ID to Fundraising Contact******Start****
                    else if((SelectedFields[i][2] == 'Fundraising Contact ID' && "{!UsingPageName}" == "MEF"))
                    {
                        comboSltobj{!componentID}.setItemText('Fundraising Contact',i);
                    }
                    //************Change Fundraising Contact ID to Fundraising Contact******End****
                    
                    else if(SelectedFields[i][2] == 'Account'  && "{!UsingPageName}" == "CMF"){
                       //alert('SelectedFields[i][2]   '+SelectedFields[i][2]);
                       comboSltobj{!componentID}.setItemText('Account Name',i);
                    }
                    else if(SelectedFields[i][2] == 'Last Email Sent'){
                        comboSltobj{!componentID}.setItemText('Email Sent',i);
                    }
                    else
                    {
                        comboSltobj{!componentID}.setItemText( HTMLEncode1(SelectedFields[i][2]), i);
                    }
            }
            comboSltobj{!componentID}.setItemCount(SelectedFields.length);
            comboSltobj{!componentID}.setId("sellist{!componentID}");  
            comboSltobj{!componentID}.setSize(240,206);
            
            
            comboSltobj{!componentID}.onKeyUp  = function(event){
                return 'disabled';
            }
            
            comboSltobj{!componentID}.onKeyDown  = function(event){
                return 'disabled';
            }
            
            comboSltobj{!componentID}.onKeyLeft  = function(event){
                return 'disabled';
            }
            
            comboSltobj{!componentID}.onKeyRight = function(event){
                return 'disabled';
            }
            
            
            comboSltobj{!componentID}.onItemClicked = function(event, index){
                //alert('CHECk'+this.getItemText(index));
                var newPos = localSltArray{!componentID}.length;

                
                for(var i=0;i<newPos;i++){
                    if(i != index){
                        $('#sellist{!componentID}-item-'+i).removeClass('aw-items-selected');
                        $('#sellist{!componentID}-item-'+i).removeClass('aw-items-current');
                        $('#sellist{!componentID}-item-'+i).addClass('aw-items-normal');
                    }
                    else{
                        $('#sellist{!componentID}-item-'+i).addClass('aw-items-selected');
                        $('#sellist{!componentID}-item-'+i).addClass('aw-items-current');
                        $('#sellist{!componentID}-item-'+i).removeClass('aw-items-normal');
                    }
                }
