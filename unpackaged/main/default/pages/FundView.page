                /*This function returns the apiName in commitmentApi and partnershipApi
                  also gets the Label of fields*/
                function getDescribeObject(objName,arrName){                   
                    var resultfieldarray =[];
                    var result;
                    if(objName == 'Commitment__c'){
                        result = sforce.connection.describeSObject(Namespaceprefix1+objName);
                        
                    }
                    else
                        result = sforce.connection.describeSObject(Namespaceprefix1+objName);
                        
                    
                    //This block puts the fields from the describe call on object into the resultfieldarray array
                    for (var i = 0; i < result.fields.length; i++) 
                    {
                        var field = result.fields[i];
                        var fieldarray = new Array();
                        if (field.type == 'reference') {
                            fieldarray.push(field.name);
                            fieldarray.push(field.label);
                            fieldarray.push(field.type);
                        } 
                        else if (field.type != 'textarea') 
                        {
                            fieldarray.push(field.name);
                            fieldarray.push(field.label);
                            fieldarray.push(field.type);
                        } 
                        else if (field.type == 'textarea' && field.length <= 255) 
                        {
                            fieldarray.push(field.name);
                            fieldarray.push(field.label);
                            fieldarray.push(field.type);
                        }
                        if (fieldarray.length > 0) 
                        {
                            resultfieldarray.push(fieldarray);
                        }
                    }
                    
                    for (var j = 0; j < resultfieldarray.length; j++) 
                    {
                        var fldtype = resultfieldarray[j][2].toUpperCase();
                        var fldname = resultfieldarray[j][0].toLowerCase();
                        if(objName == 'Commitment__c')
                        {
                            if ((fldtype != 'ENCRYPTEDSTRING') && (fldtype != 'ID') && (resultfieldarray[j][0].toUpperCase() != 'SYSTEMMODSTAMP') && (resultfieldarray[j][0].toLowerCase() !='jigsawcompanyid') && (fldname != 'jigsaw') ) 
                            {
                                arrName.push(resultfieldarray[j][0]);
                                CommitmentLabelSecurity.push(resultfieldarray[j][1]);
                            }
                        }
                        else if(objName =='Partnership__c')
                        {
                            if ((fldtype != 'ENCRYPTEDSTRING') && (fldtype != 'ID') && (resultfieldarray[j][0].toUpperCase() != 'SYSTEMMODSTAMP') && (resultfieldarray[j][1].toLowerCase() != 'jigsaw contact id') && (fldname != 'jigsaw') ) 
                            {
                                arrName.push(resultfieldarray[j][0]);
                                PartnershipLabelSecurity.push(resultfieldarray[j][1]);
                            }
                        }
                    }
                    arrName.push('RecordTypeId');
                    //targetLabelSecurity.push('Record Type');
                    return arrName;
                }
                 
