                    <script>

                    /*Method for date format check*/
                    function fnSetDateFormat(oDateFormat)
                    {
                        oDateFormat['FullYear']; //Example = 2007
                        oDateFormat['Year']; //Example = 07
                        oDateFormat['FullMonthName']; //Example = January
                        oDateFormat['MonthName']; //Example = Jan
                        oDateFormat['Month']; //Example = 01
                        oDateFormat['Date']; //Example = 01
                        oDateFormat['FullDay']; //Example = Sunday
                        oDateFormat['Day']; //Example = Sun
                        oDateFormat['Hours']; //Example = 01
                        oDateFormat['Minutes']; //Example = 01
                        oDateFormat['Seconds']; //Example = 01
                        var sDateString;
                        if (localeString == "sl_SI" || localeString == "sl") //d.m.yy
                        {
                            sDateString = oDateFormat['Date'] + "." + oDateFormat['Month'] + "." + oDateFormat['Year'];
                        } else if (localeString == "cs" || localeString == "cs_CZ" || localeString == "fi" || localeString == "fi_FI" || localeString == "is_IS" || localeString == "sk" || localeString == "sk_SK" || localeString == "be_BY" || localeString == "mk_MK" || localeString == "fi_FI_EURO" || localeString == "is" || localeString == "mk") // d.m.yyyy
                        {
                            sDateString = oDateFormat['Date'] + "." + oDateFormat['Month'] + "." + oDateFormat['FullYear'];
                        } else if (localeString == "sr" || localeString == "sr_CS") //d.m.yyyy.
                        {
                            sDateString = oDateFormat['Date'] + "." + oDateFormat['Month'] + "." + oDateFormat['FullYear'] + ".";
                        } else if (localeString == "et_EE" || localeString == "et" || localeString == "de_DE_EURO") // d.mm.yyyy
                        {
                            sDateString = oDateFormat['Date'] + "." + oDateFormat['Month'] + "." + oDateFormat['FullYear'];
                        } else if (localeString == "en_IN" || localeString == "el" || localeString == "el_GR" || localeString == "th" || localeString == "ur_PK" || localeString == "ur") //d/m/yyyy
                        {
                            sDateString = oDateFormat['Date'] + "/" + oDateFormat['Month'] + "/" + oDateFormat['FullYear'];
