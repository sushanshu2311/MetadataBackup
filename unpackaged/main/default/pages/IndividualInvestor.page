                /*@Descrption: Used for view error message for requird field on page.*/
                function checkRequiredField()
                {  
                     
                    inputValue = '';  
                    isBlankReqFieldLeft = viewRequiredfieldError(arrLeftColumInputClass);
                    isBlankReqFieldRight = viewRequiredfieldError(arrRightColumInputClass);              
                    
                    /* *********FOR STATIC FEILDS********* */
                    /*Last Name Check*/
                    if(document.getElementById("thePage:theForm:lastNameIF").value == '')
                    {
                        document.getElementById("lastNameId").style.display="block";
                        document.getElementById("thePage:theForm:lastNameIF").style.border="2px solid #c23934";
                        isBlankReqFieldLeft = "true";
                    }
                    /*Description Check*/
                    if(document.getElementById("thePage:theForm:descFormIF").value == '')
                    {
                        if(arrObjRequiredFeild.indexOf('Contact:Description') > -1 || arrObjRequiredFeild.indexOf('contact:description') > -1)
                        {
                            document.getElementById("conDescripId").style.display="block";
                            document.getElementById("thePage:theForm:descFormIF").style.border="2px solid #c23934";
                            isBlankReqFieldLeft = "true";
                        }
                    }
                    /*Phone Check*/
                    if(document.getElementById("thePage:theForm:phoneFormIF").value == '')
                    {
                        if(arrObjRequiredFeild.indexOf('Contact:Phone') > -1 || arrObjRequiredFeild.indexOf('contact:phone') > -1)
                        {
                            document.getElementById("phoneId").style.display="block";
                            document.getElementById("thePage:theForm:phoneFormIF").style.border="2px solid #c23934";
                            isBlankReqFieldRight = "true";
                        }
                    }
                    /*Fax Check*/
                    if(document.getElementById("thePage:theForm:faxFormIF").value == '')
                    {
                        if(arrObjRequiredFeild.indexOf('Contact:Fax') > -1 || arrObjRequiredFeild.indexOf('contact:fax') > -1)
                        {
                            document.getElementById("faxId").style.display="block";
                            document.getElementById("thePage:theForm:faxFormIF").style.border="2px solid #c23934";
                            isBlankReqFieldRight = "true";
                        }
                    }
                    /*Mobile Phone Check*/
                    if(document.getElementById("thePage:theForm:mPhoneFormIF").value == '')
                    {
                        if(arrObjRequiredFeild.indexOf('Contact:MobilePhone') > -1 || arrObjRequiredFeild.indexOf('contact:mobilephone') > -1)
                        {
                            document.getElementById("mobPhoneId").style.display="block";
                            document.getElementById("thePage:theForm:mPhoneFormIF").style.border="2px solid #c23934";
                            isBlankReqFieldRight = "true";
                        }
                    }
                    /*Email Check*/
                    if(document.getElementById("thePage:theForm:emailFormIF").value == '')
                    {
                        if(arrObjRequiredFeild.indexOf('Contact:Email') > -1 || arrObjRequiredFeild.indexOf('contact:email') > -1)
                        {
                            document.getElementById("emailIdId").style.display="block";
                            document.getElementById("thePage:theForm:emailFormIF").style.border="2px solid #c23934";
                            isBlankReqFieldRight = "true";
                        }
                    }
                    
                    if(isBlankReqFieldRight.indexOf('true') > -1 || isBlankReqFieldLeft.indexOf('true') > -1){
