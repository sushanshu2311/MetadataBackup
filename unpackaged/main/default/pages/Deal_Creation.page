        function removeErrorMessage(){
        
            var checkErrorSourceFirm = $(".Additional_fields_for_new_Source_Firm").find("div.errorMsg");            
            var checkErrorSource_Contact = $(".New_Source_Contact").find("div.errorMsg");
          
            if(checkErrorSourceFirm.length >0 || checkErrorSource_Contact.length >0){
                        
                var fieldClasses = document.getElementsByClassName('error');                
                if(fieldClasses.length >0)
                {
                    for(var i=0;i<fieldClasses.length;i++)
                    {                   
                        fieldClasses[i].classList.remove('error');                      
                        fieldClasses = document.getElementsByClassName('error');                
                        i=i-1;
                    }
                }
                
                var checkError = document.getElementsByClassName('errorMsg');
                  if(checkError.length >0)
                  {
                   
                    for(var j=0;j<checkError.length;j++)
                     { 
                        var errorData = checkError[j].innerHTML;
                        var dataError = errorData.split('<strong>Error:</strong> ').join('');                        
                         checkError[j].innerHTML = '';
                      }  
                    
                  }   
            }       
        }
                        
        function loadPopupnew(cid1,cid2)
        {
            if(popupStatus==0){
                $('.'+cid1).css({
                    "opacity": "0.5"
                });
                $('.'+cid1).fadeIn("slow");
                $('.'+cid2).fadeIn("slow");
                popupStatus = 1;
            }
        }
        
        function centerPopupnew(cid)
        {
            //request data for centering
            var windowWidth = document.documentElement.clientWidth;         
            var windowHeight = document.documentElement.clientHeight;
            
            var popupHeight = $('.'+cid).height();
            var popupWidth = $('.'+cid).width();
            
            if (navigator.userAgent.match(/iPad/i)) {           
                //continue
            }else{
                //centering
                $('.'+cid).css({
                    "position": "fixed",
                    "top": windowHeight/2-popupHeight/2,
                    "left": windowWidth/2-popupWidth/2
                });
            }
        }
                
        function closepopup(bgdivid,popupdivid)
        {
            disablePopupnew(bgdivid);
            $('.'+popupdivid).fadeOut("slow");
        } 
        
        function disablePopupnew(cid){
            if(popupStatus==1){
                $('.'+cid).fadeOut("slow");
                popupStatus = 0;
            }   
        }
        
</script>
