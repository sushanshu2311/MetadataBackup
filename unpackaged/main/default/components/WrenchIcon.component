        function getEnterEvent_select_contact{!componentID}(e,th)
        {
            if(e.keyCode == 13)
            {
                search_flds{!componentID}();
                document.getElementById('clearsearchdsb1{!componentID}').style.display = 'none';
                document.getElementById('clearsearchenb1{!componentID}').style.display = 'block';
            }
            else if(e.keyCode ==8 || e.keyCode ==46)
            {
                if(th.value != '')
                 {
                    document.getElementById('clearsearchdsb1{!componentID}').style.display = 'none';
                    document.getElementById('clearsearchenb1{!componentID}').style.display = 'block';
                 }
            
                 if(th.value == '')
                 {
                    document.getElementById('clearsearchdsb1{!componentID}').style.display = 'block';
                    document.getElementById('clearsearchenb1{!componentID}').style.display = 'none';
                    deselectName{!componentID}('Current_Selected_Fields{!componentID}');
                    deselectName{!componentID}('All_Available_Fields{!componentID}');
                    resetAvailablelist{!componentID}();
                    var searchtxt=document.getElementById('searchcon_grid1{!componentID}').value; 
                    searchtxt=searchtxt.trim();
                    var len=localAvlArray{!componentID}.length; 
                    
                    for (var count=len-1; count>=0; count--) 
                    {    
                        if (localAvlArray{!componentID}[count][2].toLowerCase().indexOf(searchtxt.toLowerCase())==-1) 
                        {
                            localAvlArray{!componentID}.splice(count,1);
                        }
                    }
                    if(localAvlArray{!componentID}.length == 0)
                    {
                        localAvlArray{!componentID}.push(['','','No match found.']);
                    }
                    createAvlSelList{!componentID}(localAvlArray{!componentID}); 
                                       
                    document.getElementById('searchcon_grid1{!componentID}').value=searchtxt;
                    
                 }
            }
            else if(document.getElementById('searchcon_grid1{!componentID}').value!='')
            {
                if(e.keyCode!=8)
                {
                document.getElementById('clearsearchdsb1{!componentID}').style.display = 'none';
                document.getElementById('clearsearchenb1{!componentID}').style.display = 'block';
                }
            }   
        }
        
        function moveTop_Bottom{!componentID}(direction)
        {
            try
            {
                isRestore{!componentID} = 0;
                document.getElementById('_apply{!componentID}').style.display ='inline-block';  
                document.getElementById('_applydeactve{!componentID}').style.display ='none';         
                //document.getElementById('_apply{!componentID}').style.pointerEvents = 'auto';
                var SlectedIndex = parseInt(comboSltobj{!componentID}.getSelectedItems());
                
                if(direction=='Top')
                {   
                    if("{!UsingPageName}" == "ICG"){
                      //  document.getElementById('_apply{!componentID}').style.display ='inline';  
                       // document.getElementById('_applydeactve{!componentID}').style.display ='none'; 
                        
                        localSltArray{!componentID}.unshift( localSltArray{!componentID}[SlectedIndex] );
                        localSltArray{!componentID}.splice( ++SlectedIndex,1 );
                        var value = localSltArray{!componentID}[0];
                        localSltArray{!componentID}.splice( 0,1 );
                        
                        localSltArray{!componentID}.splice(1,0,value); 
                        createSeltList{!componentID}(localSltArray{!componentID}); 
                          
                        // change seleted css.
                        comboSltobj{!componentID}.setSelectedItems(1);
                        $('#sellist{!componentID}-item-1').removeClass('aw-items-normal');
                        $('#sellist{!componentID}-item-1').addClass('aw-items-selected');
                    
                    }
                    else{
                        localSltArray{!componentID}.unshift( localSltArray{!componentID}[SlectedIndex] );
                        localSltArray{!componentID}.splice( ++SlectedIndex,1 );
                        createSeltList{!componentID}(localSltArray{!componentID}); 
                          
                        // change seleted css.
                        comboSltobj{!componentID}.setSelectedItems(0);
                        $('#sellist{!componentID}-item-0').removeClass('aw-items-normal');
                        $('#sellist{!componentID}-item-0').addClass('aw-items-selected');
                    }
                }
                else if(direction=='Bottom')
                {           
                    localSltArray{!componentID}.push( localSltArray{!componentID}[SlectedIndex] );
                    localSltArray{!componentID}.splice( SlectedIndex,1 );
                    createSeltList{!componentID}(localSltArray{!componentID}); 
                    
                    // change seleted css.
                    var newPos = localSltArray{!componentID}.length-1;
                    comboSltobj{!componentID}.setSelectedItems(newPos);
                    
                    $('#sellist{!componentID}-item-'+newPos).removeClass('aw-items-normal');
                    $('#sellist{!componentID}-item-'+newPos).addClass('aw-items-selected'); 
                }
                enablebuttonsotherdetailselectlist{!componentID}(0,0,0);
                checkForRestoreButton{!componentID}();
            }
            catch(ex){
                alert('moveTop_Bottom  '+ex);
            }
        }
        
        // move up and down.
        function moveUp_Down{!componentID}(direction)
        {   
            try
            {
                flag{!componentID}=true;
                isRestore{!componentID} = 0;
                document.getElementById('_apply{!componentID}').style.display ='inline-block';   
                document.getElementById('_applydeactve{!componentID}').style.display ='none';             
                //document.getElementById('_apply{!componentID}').style.pointerEvents = 'auto';
                var SlectedIndex = parseInt(comboSltobj{!componentID}.getSelectedItems());
