                        }                   
                        
                        for(var i = 0; i < arrRecordType.length; i++) {                    
                            var arrRecordType2= arrRecordType[i];                   
                            arrRecordType2 = arrRecordType[i].split('^'); //to get object and recordtype id     
                           
                            var recordtype_id ='';   //contain recordtype id
                            var objname = '';        //contain object name           
                           
                            for(var j = 0; j < arrRecordType2.length; j++) {
                                if(j==0){
                                    objname= arrRecordType2[j];
                                    
                                }
                                if(j==1){
                                    recordtype_id= arrRecordType2[j];                          
                                }
                            } 
                            var strRequiredFeild = '';                      
                            
                            if(objname.indexOf('Institution')==0){
                                strRequiredFeild = gerRequiredFeildsOnPageLayout('Account' ,recordtype_id);   //get required fields from sobject layout               
                                strRequiredFeild = strRequiredFeild.toString();
