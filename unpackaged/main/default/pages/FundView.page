                //This function execute the query, calculate the total commitment and bind the data in the grouping of fund
                function executeQuery(fields)
                {
                    try
                    {
                        showImz();
                        if (ischeckLoadFlag == true){
                            SortClicked=false;
                            colDirection='descending';
                            direction='DESC NULLS LAST' ;
                        }
                        
                        arrcheckboxIndex = new Array();
                        arrdatetimeIndex = new Array();
                        arrdateIndex = new Array();
                        arrCommitmentIndex = new Array();   
                        arrcurrencyIndex = new Array();
                        arrHeaderNames = new Array();
                        arrApiFieldsNames = new Array();
                        getSelectedfields = new Array();
                        arrAllFinalGridRecords = new Array();
                        arrfieldsDataType = new Array();
                        var getcolumn;
                        columnarry = new Array();
                        var queryMore = true;
                        var TotalCommitmentAmount=0;
                        var fundForTotalCom;
                        var rowVal1 = new Array();
                        fundName = '';
            
                        if(fields != null && fields != 'null' && fields != '')
                        {            
                            getSelectedfields = fields;
                        }
                        else
                        {
                            return false;
                        }            
                        // set header values and create query.
                        setHeaderValues();
                        getcolumn = getqueryMain.substring(6,getqueryMain.indexOf('from'));                         
                        var clumnsplit = getcolumn.split(',');                      
                        for( var c=0; c<clumnsplit.length; c++)
                        {
                           columnarry.push(clumnsplit[c].trim());
                        }                      
                        var mainqueryresult = sforce.connection.query(getqueryMain);                      
                        while(queryMore)
                        {
                            var records;    
                            records = mainqueryresult.getArray("records");
                            for(var i=0;i<records.length;i++)
                            {
                                rowVal1 = new Array();
                                
                                var LPVal = records[i].get(Namespaceprefix1+"Limited_Partner__r");
                                var LPId = LPVal.get('Id');
                                var partnershipVal = records[i].get(Namespaceprefix1+"Partnership__r");
                                var partnershipId = partnershipVal.get('Id');
                                var fundVal = records[i].get(Namespaceprefix1+"Partnership__r");
                                var fId = fundVal.get(Namespaceprefix1+"Fund__c");
                                var PC_Val = records[i].get(Namespaceprefix1+"Portfolio_Company__r");
                                if(PC_Val != null)
                                var pcid=PC_Val.get('Id');                              
                                for(var j=0;j<columnarry.length;j++)
                                {   
                                   if(columnarry[j] == Namespaceprefix1+"Partnership__r."+Namespaceprefix1+"Fund__r.Name")
                                    {                              
                                        var fund = fundRecords(columnarry[j] , records[i]);
                                    }     
                                   
                                    if(((fund!= null || fund != '') && fund != fundName)|| fundName == '' || fundName == null)
                                    {
                                        fundName = fund;
                                        TotalCommitmentAmount=0;
                                        
                                        for(var m=0;m<records.length;m++)
                                        {
                                            for(var n=0;n<columnarry.length;n++)
                                            { 
                                                if(columnarry[n] == Namespaceprefix1+"Partnership__r."+Namespaceprefix1+"Fund__r.Name")
                                                {
                                                    fundForTotalCom = fundRecords(columnarry[n] , records[m]);
                                                }
                                                else{
                                                    fundForTotalCom = '';
