            /*
             *This function is used to sort all the fields within the array before they are added to the select list of the fields of all the objects
             *@param getarray           array of fields to be sorted
             *@param sortingcloumn      index of the column based on which the sorting needs to be done
             *@param sortingdirection   direction of sorting, ascending or descending
            */              
            function sortarraydata(getarray,sortingcloumn,sortingdirection)
            {      
                if(sortingdirection=='ASC')
                {
                   getarray.sort(function (a,b)
                   {
                        var x = a[sortingcloumn].toLowerCase(), y = b[sortingcloumn].toLowerCase();
                        
                        if (x > y) return  1;
                        if (x< y) return -1;
                        return 0;
                    });
                    
                }
                else
                {              
                    getarray.sort(function (a,b) {
                    var x = a[sortingcloumn].toLowerCase(), y = b[sortingcloumn].toLowerCase();
                 
                    if (x< y) return  1;
                    if (x > y) return -1;
                    return 0;
                    }); 
                }  
                return getarray;
            }
          
           //@Load the Account,Contact,Fundraising,FundraisingContact,Fund Value in dropdown at Page Load     
            function _describe_function()
            { 
                fundIdByController=document.getElementById('pageid:frm:fndId').value;              
                InstIdByController = '{!isInstId}';
                
                //This block puts the fields from the describe call on Account object into the accountfieldarray array
                var result = sforce.connection.describeSObject("account");               
                
                for (var i=0; i<result.fields.length; i++)
                {
                    var field = result.fields[i];
                    var fieldarray=new Array();
                    if(field.type=='reference')
                    {
                        if(field.name !='MasterRecordId')
                        {                           
                            fieldarray.push(field.relationshipName);
                            fieldarray.push(field.label);
                            fieldarray.push(field.type);
                        }                        
                    }
                    else if(field.type!='textarea' && field.type!='address')
                    {    
                        var x = field.name;
                        var y = field.label;
                        if(x.indexOf("__c") == -1)
                        {
                            if(y.indexOf("Institution") != 1 && x != 'AccountNumber' )
                            {
                                y = y.replace(/Institution /gi, "");
                            }
                        }
                        // External_System_ID__c filed will not bind in Account filter
                        if(x!=Namespaceprefix1+'External_System_ID__c')
                        {
                            fieldarray.push(field.name);
                            fieldarray.push(y);                 
                            fieldarray.push(field.type);
                        }                       
                    }
                    else if(field.type =='textarea' && field.length<=255)
                    {
                        var x = field.name;
                        var y = field.label;
                        if(x.indexOf("__c") == -1)
                        {
                            if(y.indexOf("Institution") != 1 && x != 'AccountNumber')
                            {
                                y = y.replace(/Institution /gi, "");
                            }
                        }
                    
                        fieldarray.push(field.name);
                        fieldarray.push(field.label);                     
                        fieldarray.push(field.type); 
                    }       
                    if(fieldarray.length>0)
                    {
                        accountfieldarray.push(fieldarray);
                    }
                }
                    

                accountfieldarray=sortarraydata(accountfieldarray,1,'ASC');
                for(var i=1;i<=1;i++)
                {
                // Adding Accounts field in selection crtieria picklist, as initially we are showing 1, so take loop of one
                   for(var j=0;j<accountfieldarray.length;j++)
                    { 
                        var accountfldtype=accountfieldarray[j][2].toUpperCase();                        
                        if((accountfldtype!='ENCRYPTEDSTRING') && (accountfldtype!='ID') && (accountfieldarray[j][0].toUpperCase()!='SYSTEMMODSTAMP') && (accountfieldarray[j][0].toLowerCase()!='jigsaw')&& (accountfieldarray[j][0].toLowerCase()!='jigsawcompanyid') || (accountfieldarray[j][0] == 'RecordType'))
                        {            
                            if(accountfieldarray[j][0] == 'RecordType')
                            {
                                accountfieldarray[j][0] = 'RecordType.name';
                            }
                            var value1='Account:'+accountfieldarray[j][0]+':'+accountfieldarray[j][1]+':'+accountfieldarray[j][2];
                            arrayOfAccountFields.push('Account:'+accountfieldarray[j][1]);
                           arryAccountContactApiLabel['Account:'+accountfieldarray[j][1]] = value1;
                        }
                    }                       
                }
                    
                    
                <!--Describe call for Contact Object-->
                 //contactfieldarray contains the name,label and type of all the  fields of Contact object 
                 //This block puts the fields from the describe call on Contact object into the contactfieldarray array .           
                var result = sforce.connection.describeSObject("contact");
                for (var i=0; i<result.fields.length; i++) 
                {
                    var field = result.fields[i];
                    var fieldarray=new Array();
                    if(field.type=='reference')
                    {
                       
                        //**MasterRecordId filed will not bind in Contact filter**Start**
                        if(field.name !='MasterRecordId')
                        {
                            fieldarray.push(field.relationshipName); 
                            fieldarray.push(field.label);            
                            fieldarray.push(field.type);
                        }
                        //**MasterRecordId filed will not bind in Contact filter**End**
                    }
                    else if(field.type!='textarea' && field.type!='address')
                    {
                        
                        //**External_System_ID__c filed will not bind in Contact filter**Start**
                        if(field.name !=Namespaceprefix1+'External_System_ID__c')
                        {
                            fieldarray.push(field.name);
                            fieldarray.push(field.label);
                            fieldarray.push(field.type);
                        }
                        //**External_System_ID__c filed will not bind in Contact filter**End**
                    }
                    else if(field.type =='textarea' && field.length<=255)
