            function checkdate(input)
            {
                 var _dd=new Date(input);
                 var sp_dd=input.split('/');
                 var dd = _dd.getDate();
                 var mm = _dd.getMonth()+1;
                 var yyyy = _dd.getFullYear();
                if(sp_dd.length==1)
                {
                    return false;
                }
                if(yyyy=='2001')
                {
                    return false;
                }
                if(sp_dd[0]==yyyy)
                {                  
                    return false;
                }
                else
                {
                    if(dd<10)
                    {
                        dd='0'+dd;
                    } 
                    if(mm<10)
                    {
                        mm='0'+mm;
                    } 
                    dateformat = dd+'/'+mm+'/'+yyyy;
                    var validformat=/^\d{2}\/\d{2}\/\d{4}$/ //Basic check for format validity
                    return validformat.test(dateformat);
                } 
            }

