<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Capital_Amount</fullName>
    <active>true</active>
    <errorConditionFormula>if( Capital_Amount__c &lt;0,true,false)</errorConditionFormula>
    <errorDisplayField>Capital_Amount__c</errorDisplayField>
    <errorMessage>Capital Amount cannot be less than zero.</errorMessage>
</ValidationRule>
