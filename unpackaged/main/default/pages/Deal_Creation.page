            }  
        }           
        return isSourcePopupReqFieldBlank;
    }
    
    function getSelectedOptions(oList)
{
       var sdValues = [];
       
       if(oList.options!=undefined){
           for(var i = 1; i < oList.options.length; i++)
           {
              if(oList.options[i].selected == true)
              {
                  sdValues.push(oList.options[i].value); // Add field Value in map in PE v4.5 By Hemendra 
              }
           }
       }
       return sdValues;
    }
    
