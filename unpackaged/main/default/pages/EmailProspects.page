                    function getNavatarSetupData()
                    {
                        try{
                            
                            var query= "select id, "+Namespaceprefix1+"Email_Prospect_Setting__c FROM "+Namespaceprefix1+"Navatar_Setup__c where OwnerId = '{!$User.Id}' ";    
                             
                            var resultdesc = sforce.connection.query(query);         
                            var recsize = resultdesc.getArray("size");

                            if(recsize == 0)
                            {
                                MainGridFilds = MainGridFildsDefalut;
                            }
                            else
                            {
                                var recordsdesc = resultdesc.getArray("records");                 
                                var MEPValue = recordsdesc[0].get(Namespaceprefix1+'Email_Prospect_Setting__c');

                                if(MEPValue != '' && MEPValue != null)
                                {
                                    if(MEPValue.indexOf('MEP:') > -1)
                                    {
                                        var gridFields = MEPValue.split('MEP:')[1];                            
                                         
                                        if(gridFields != null || gridFields != '')
                                        {
                                            MainGridFilds = gridFields.split(',');
                                        }
                                        else
                                        {
                                            MainGridFilds = MainGridFildsDefalut;
                                        } 
                                    }
                                    else
                                    {
                                        MainGridFilds = MainGridFildsDefalut;
                                    }
                                }
                                else
                                {
                                    MainGridFilds = MainGridFildsDefalut;
                                }
                            } 

                            for(i = MainGridFildsDefalut.length-1; i>=0; i--){
                                var tempField = MainGridFildsDefalut[i].split(':');

                                if(tempField[0] == 'Contact'){
                                    if(contactApiSecurity.indexOf(tempField[1]) == -1){
                                        MainGridFildsDefalut.splice(i,1);
                                    }
                                    else{
                                        if (contactLabelSecurity.indexOf(tempField[2]) == -1){
                                            tempField[2] = contactLabelSecurity[contactApiSecurity.indexOf(tempField[1])];
                                            MainGridFildsDefalut[i] = tempField[0]+':'+tempField[1]+':'+tempField[2]+':'+tempField[3];
                                        }
                                    }
                                }
                                else if(tempField[0] == Namespaceprefix1+'Marketing_Prospect__c'){
                                    if(mpApiSecurity.indexOf(tempField[1]) == -1){
                                        MainGridFildsDefalut.splice(i,1);
                                    }
                                    else{
                                        if (mpLabelSecurity.indexOf(tempField[2]) == -1){
                                            tempField[2] = mpLabelSecurity[mpApiSecurity.indexOf(tempField[1])];
                                            MainGridFildsDefalut[i] = tempField[0]+':'+tempField[1]+':'+tempField[2]+':'+tempField[3];
                                        }
                                    }
                                }                       
                            }

                            for(i = MainGridFilds.length-1;i>=0;i--)
                            {
                                 
                                var tempField = MainGridFilds[i].split(':');
                                if(tempField[0] == 'Contact'){
                                    if(contactApiSecurity.indexOf(tempField[1]) == -1){
                                        MainGridFilds.splice(i,1);
                                    }
                                    else{
                                        if (contactLabelSecurity.indexOf(tempField[2]) == -1){
                                            tempField[2] = contactLabelSecurity[contactApiSecurity.indexOf(tempField[1])];
                                            MainGridFilds[i] = tempField[0]+':'+tempField[1]+':'+tempField[2]+':'+tempField[3];
                                        }
                                    }
                                }
                                else if(tempField[0] == Namespaceprefix1+"Marketing_Prospect__c")
                                {
                                    if(mpApiSecurity.indexOf(tempField[1]) == -1){
                                        MainGridFilds.splice(i,1);
                                    }
                                    else{
                                        if (mpLabelSecurity.indexOf(tempField[2]) == -1){
                                            tempField[2] = mpLabelSecurity[mpApiSecurity.indexOf(tempField[1])];
                                            MainGridFilds[i] = tempField[0]+':'+tempField[1]+':'+tempField[2]+':'+tempField[3];
                                        }
                                    }
                                }
                            }
                            
                        }
                        catch(ex)
                        {
                            alert('Error  getNavatarSetupData:'+ex);
                        }

                    }


                    function checkInsuficientPrivilages()
                    {
                        var retVal
                        for(i = MainGridFildsInsufficientPrivilagesDefalut.length-1;i>=0;i--)
                        {
                            var tempField = MainGridFildsInsufficientPrivilagesDefalut[i].split(':');
                            
                            if(tempField[0] == 'Contact')
                            {
                                if(contactApiSecurity.indexOf(tempField[1]) == -1)
                                {
                                    return true;
                                }
                            }
                            else if(tempField[0] == Namespaceprefix1+"Marketing_Prospect__c"){
                                if(mpApiSecurity.indexOf(tempField[1]) == -1)
                                {
                                    return true;
                                }   
                            }
                        }                        
                    }
                    
