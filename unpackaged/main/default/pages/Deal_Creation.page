    //Used for view error message for requird field on page.
    function viewRequiredfieldError(InputcolumnClass){
        InputcolumnClass =  InputcolumnClass.split(',');
        var isReqField= false;      
        for(var i=0; i<InputcolumnClass.length; i++){
            className = InputcolumnClass[i];
            errorMsgCls =''; 
            if(className.indexOf('true')>0){
                var inputval = document.getElementsByClassName(""+className+"")[0].value;
                errorMsgCls = className+'ErrorMsg';
                
                if(inputval.length==0){
                    document.getElementById(""+errorMsgCls+"").style.display="block";
                    document.getElementsByClassName(""+className+"")[0].style.border="2px solid #c23934";
                    isReqField = true;
                }else{
                    document.getElementById(""+errorMsgCls+"").style.display="none";
                    document.getElementsByClassName(""+className+"")[0].style.border="1px solid #d8dde6";
                }
            } 
        }
        return isReqField;
    }
        
    function pageLoadOnComplete()
    {
        var accessControl =  '{!if(isEnableDealCreation==true,'true','false')}';//Added By Qadier Khan for PE 3.5 11 OCT 2017.
        if(accessControl == 'false' || accessControl == false)
        {            
            InsufficientPermissions_Fancybox();
        }
        else
        {       
            if(isAccHasAccess !='false' && isPiplnHasAccess !='false')          
                document.getElementById('MainContentSection').style.display = 'block';
        }
    }    
    
    function changePiclistInputClass(className, strfieldTpye)
    {
        var fieldClass = className;
        var tagType = document.getElementsByClassName(fieldClass)[0].getAttribute("type");
        var tagName = document.getElementsByClassName(fieldClass)[0].tagName;
        
        if(strfieldTpye == 'PICKLIST')
        {    
            $("."+fieldClass).addClass("slds-min-width");
            $("."+fieldClass).removeAttr("style");
        }
    }
    
    function checkDealInformationError(){        
        var checkContentBoxkError = $(".ContentBox").find("div.errorMsg"); 
        var checkError = document.getElementsByClassName('errorMsg');
        
        if(checkContentBoxkError.length >0){
            var fieldClasses = document.getElementsByClassName('error');
            if(fieldClasses.length >0)
            {
                for(var i=0;i<fieldClasses.length;i++)
                {
                    fieldClasses[i].classList.remove('error');
                    fieldClasses = document.getElementsByClassName('error');                
                    i=i-1;
                }
            }       
        }
        
        if(checkError.length >0)
        {   
            for(var j=0;j<checkError.length;j++)
            { 
                var errorData = checkError[j].innerHTML;
                var dataError = errorData.split('<strong>Error:</strong> ').join('');                   
                checkError[j].innerHTML = dataError;
                document.getElementById("thePage:theForm:legalnameinputid").dataError
            }  
            $('.errorMsg').css({"line-height":"13px","margin-bottom": "-9px","color": "#c23934","font-size": "12px"});
        }  
        
    }
    
    function changeInputClass(className, strfieldTpye)
    {
        var fieldClass = className;
        var tagType = document.getElementsByClassName(fieldClass)[0].getAttribute("type");
        var tagName = document.getElementsByClassName(fieldClass)[0].tagName;
       
        if(strfieldTpye == 'BOOLEAN')
        {    
            $("."+fieldClass).removeClass("slds-input");
            $("."+fieldClass).addClass("checkboxclass");
            var classDomName = document.getElementsByClassName('slds-inputcheckImg');           
            if(classDomName[0] != null && classDomName[0] != undefined)                     
                $("."+fieldClass).css({"display":"none"});
        }
        else if(strfieldTpye == 'PICKLIST')
        {
            $("."+fieldClass).removeClass("slds-input");
            $("."+fieldClass).addClass("slds-select");         
            $("."+fieldClass).css({"border":" 1px solid #d8dde6 !important"});
        }       
        else if(strfieldTpye == 'MULTIPICKLIST')
        {           
            MapFieldType[""+fieldClass+""] = ""+strfieldTpye+"";
            multipicklistcls.push(fieldClass); 
        }
        
        var checkContentBoxkError = $(".ContentBox").find("div.errorMsg"); 
        if(checkContentBoxkError.length >0){
            var fieldClasses = document.getElementsByClassName('error');
            if(fieldClasses.length >0)
            {
                for(var i=0;i<fieldClasses.length;i++)
                {
                    var inputClassName = '';                
                    if(fieldClasses[i].classList.item(1).indexOf('SourceCont')==0){
                        inputClassName = fieldClasses[i].classList.item(1);
                    }else if(fieldClasses[i].classList.item(2).indexOf('SourceCont')==0){
                        inputClassName = fieldClasses[i].classList.item(2);
                    } 
                    fieldClasses[i].classList.remove('error');
                    fieldClasses = document.getElementsByClassName('error');                
                    i=i-1;
                }
            }       
        }
        
        var checkError = document.getElementsByClassName('errorMsg');
        if(checkError.length >0)
        {   
            for(var j=0;j<checkError.length;j++)
            { 
                var errorData = checkError[j].innerHTML;            
                var dataError = errorData.split('<strong>Error:</strong> ').join('');                   
                checkError[j].innerHTML = dataError;
            }
            $('.errorMsg').css({"line-height":"13px","margin-bottom": "-9px","color": "#c23934","font-size": "12px"});
        }   
    }
    
    function reset_MultipicklistValue(){        
        $('.datePicker').css("position","absolute");
        try {
            for(var y = 0;  y<arrSourceFirmErrorClass.length; y++){
                document.getElementsByClassName(""+arrSourceFirmErrorClass[y]+"")[0].value = '';
                mapSourceFirmPopupValue[""+arrSourceFirmErrorClass[y]+""] = ''; 
            }
           
            for(var r = 0;  r<arrSourceContErrorClass.length; r++){ 
                document.getElementsByClassName(""+arrSourceContErrorClass[r]+"")[0].value = '';
                mapSourceContactPopupValue[""+arrSourceContErrorClass[r]+""] = ''; 
            }
                    
            for(var j = 0;  j<multipicklistcls.length; j++){                
                var selectList = document.getElementsByClassName(multipicklistcls[j])[0];
                var selectOptions = selectList.getElementsByTagName('option');              
                var strMPicklistValue = '';
                
                if(mapMultipicklistValue[""+multipicklistcls[j]+""]!=null){
                    strMPicklistValue = mapMultipicklistValue[""+multipicklistcls[j]+""];
                } 
                
                for(var i = 0; i < selectOptions.length; i++)
                {
                    var opt = selectOptions[i]; 
                    if(opt.selected)
                    {                   
                        if(strMPicklistValue.indexOf(opt.value)==-1){                       
                            selectList.options[i].selected = false;
                        }
                    }else{
                       
                        if(strMPicklistValue.indexOf(opt.value)>-1){                       
                            selectList.options[i].selected = true;
                        }
                    }
                }
            }        
            multipicklistcls.length = 0;
        }catch(err){
            console.log(err); //gives the default message
        }
    }
        
</script>
