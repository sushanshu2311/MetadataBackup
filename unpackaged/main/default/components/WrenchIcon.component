        function describeobj_method_main{!componentID}(getobjectname)
        {
            try
            {

               
                var tempobj={};
                var result = sforce.connection.describeSObject(getobjectname);
               
                for (var i=0; i<result.fields.length; i++) 
                {
                    var field = result.fields[i];
                    var fieldarray=new Array();
                    if(field.length == '' || field.length <= 255 || field.type == 'multipicklist' || field.type == 'picklist' || (field.length == 1300 && field.type == 'string')){
                        fieldarray.push(getobjectname);
                        fieldarray.push(field.name);
                        var label1=field.label;
                        var fldtype=field.type;
                        
                        //changing label of Assigned To Id field
                        if(getobjectname.toLowerCase()=='ActivityHistory'.toLowerCase() || getobjectname.toLowerCase()=='OpenActivity'.toLowerCase())
                        {
                            if(field.name.toLowerCase()=='OwnerId'.toLowerCase())
                            label1='Assigned To';
                        }
                        
                        fieldarray.push(label1);
                        fieldarray.push(field.type); 
                        var element1=field.name;
                        tempobj[element1]=fieldarray;   
                    }   
                }  
               
                return tempobj;
            }
            catch(ex){
                if(ex.faultcode == 'sf:INVALID_SESSION_ID'  ){
                    alert('Your session has expired. Please refresh your page.');
                }
                else
                    alert('describeobj_method_main  '+ex);
            }
        }
        
