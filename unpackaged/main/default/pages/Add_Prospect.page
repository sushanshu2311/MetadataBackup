            <script> 
            document.getElementById('loadprogress').style.display = 'none';
            var XTree;

            /* Method create for search functionality in report tree*/
             function Searchreportgrid() 
            {
               try 
                {
                    
                    XTree = tree.getRootNode();
                    var StrDataAr = new Array();
                    var StrDataAr1 = new Array();
                    var StrDataAr2 = new Array();
                    var Counter1 = 0;
                    var Text = document.getElementById('SearchContent3').value;
                    if (Text.length > 0) 
                    {
                      var ret = FindChildRecursively(XTree, Text);
                      var Findindex = ret.indexOf('/');
                      for (var i = 0; i < Findindex; i++) {
                         StrDataAr.push(ret[i]);
                        }
                         if (StrDataAr.length == 0)
                        {
                            if (document.getElementById('newTreeDiv1') == null) 
                            {
                                maind = 'searchBox';
                                var Tree1Div = document.getElementById(maind);
                                var textBox = document.getElementById("SearchContent3");
                                var NewDiv = document.createElement("div");
                                NewDiv.setAttribute('id', 'newTreeDiv1');
                                NewDiv.setAttribute('style', 'font-weight:bold;padding: -4px 0px;color: #ff0000 !important;');
                                NewDiv.innerHTML = "<p>No match found.</p>";
                                Tree1Div.appendChild(NewDiv, textBox);
                            }
                        }
                        else
                        {
                            if (document.getElementById('newTreeDiv1') != null) {
                            document.getElementById(maind).removeChild(document.getElementById('newTreeDiv1'));
                            }                        
                        }
                        for (var i = Findindex + 1; i < ret.length; i++){
                        StrDataAr1.push(ret[i]);
                        } 
                        if (StrDataAr != '') // show matching nodes in tree
                        {
                            for (var p = 0; p < StrDataAr.length; p++) 
                            {
                                var Path = tree.getNodeById(StrDataAr[p]).getPath();
                                tree.expandPath(Path);
                                tree.getNodeById(StrDataAr[p]).ui.show();
                                Counter1++;
                            }
                        } else {}
                        if (StrDataAr1 != '') // hide non-matching nodes in tree
                        {
                            for (var p = 0; p < StrDataAr1.length; p++) 
                            {
                                var Path = tree.getNodeById(StrDataAr1[p]).getPath();
                                tree.expandPath(Path);
                                tree.getNodeById(StrDataAr1[p]).ui.hide();
                                Counter1++;
                            }
                        }
                        StrDataAr = [];
                        ret = [];
                        arr = [];
                    }
                    else // when no text is entered in text box
                    {
                        if (document.getElementById('newTreeDiv1') != null) {
                        document.getElementById(maind).removeChild(document.getElementById('newTreeDiv1'));
                        }
                        var Treenod1 = XTree.childNodes; //gets Parent nodes of tree                                
                        for (var i = 0, len = Treenod1.length; i < len; i++) {
                            if (Treenod1[i].hasChildNodes) 
                            {
                                Treenod1[i].ui.show();
                                tree.getLoader().doPreload(Treenod1[i]);
                                var ChiildsNode = Treenod1[i].childNodes;
                                for (var j = 0, len1 = ChiildsNode.length; j < len1; j++) {
                                    ChiildsNode[j].ui.show(); // show child nodes of tree when no matching node found
                                }
                            } 
                            else {
                                Treenod1[i].ui.show();
                            }
                        }                            
                   }
                }
                catch(err){
                sessionError(err);                  
             
                }
            }
            /* function for report tree*/
            function Clear_Reporttree()
            {
                try
                {
                    if (document.getElementById('newTreeDiv1') != null) {
                    document.getElementById(maind).removeChild(document.getElementById('newTreeDiv1'));
                    }
                    var Treenod1 = XTree.childNodes; //gets Parent nodes of tree                                     
                    for (var i = 0, len = Treenod1.length; i < len; i++) 
                    {
                        if (Treenod1[i].hasChildNodes) 
                        {
                            Treenod1[i].ui.show();
                            tree.getLoader().doPreload(Treenod1[i]);
                            var ChiildsNode = Treenod1[i].childNodes;
                            for (var j = 0, len1 = ChiildsNode.length; j < len1; j++) {
                            ChiildsNode[j].ui.show(); // show child nodes of tree when no matching node found
                            }
                        } 
                        else 
                        {
                        Treenod1[i].ui.show();
                        }
                    }

                }
                catch(err){
                sessionError(err); 
                }            
            }

            /* function for report tree to find child nodes*/
            function FindChildRecursively(tree,value)
            {         
                try
                {
                    var Treenod = tree.childNodes;                            
                    var id_arr = new Array();
                    var arr1 = new Array();
                    var searchingtext = value
                    try{
                    searchingtext = searchingtext.toLowerCase();
                    }
                    catch(ex){
                    searchingtext = searchingtext;
                    }
                    for(var i = 0, len = Treenod.length; i < len; i++)
                    {
                        var parentsearch = 0;  // variable to check if parent value is found or not depending on that whether to add in hide array or not
                        var textData1 = Treenod[i].text;
                        if(textData1.toLowerCase().substring(0,searchingtext.length).indexOf(searchingtext)>=0)
                        {
                            id_arr.push(Treenod[i].id);
                            parentsearch =1;
                            tree.getLoader().doPreload(Treenod[i]);
                            var ChiildsNode = Treenod[i].childNodes ;
                            var Counter = 0 ;
                            for(var j = 0, len1 = ChiildsNode.length; j < len1; j++){
                                id_arr.push(ChiildsNode[j].id);
                            }
                        }
                        if(parentsearch == 0)
                        {
                            tree.getLoader().doPreload(Treenod[i]);
                            var ChiildsNode = Treenod[i].childNodes ;
                            var Counter = 0 ;
                            for(var j = 0, len1 = ChiildsNode.length; j < len1; j++)
                            {
                                var data2 = ChiildsNode[j].text;
                                if(data2.toLowerCase().indexOf(searchingtext)>=0)
                                {     // If entered text is found in child Node
                                    if(id_arr.indexOf(Treenod[i].id) == -1)
                                    {
                                    id_arr.push(Treenod[i].id);
                                    }
                                    id_arr.push(ChiildsNode[j].id);
                                } 
                                else
                                {   // If the child element text is not matching then adding that to hide array .
                                    Counter ++ ;
                                    arr1.push(ChiildsNode[j].id);
                                }          
                            }
                            if(ChiildsNode.length == Counter &&  parentsearch =='0'){
                                // If None of the child elements are not matching the criteria and adding its parent only if parent is not matching entered value to hide from UI . 
                                arr1.push(Treenod[i].id);  
                            }   
                        }        
                    }
                    id_arr.push('/'); 
                    for(var i = 0 ; i <arr1.length;i++){
                    id_arr.push(arr1[i]);
                    }            
                    return id_arr;   
                }
                catch(err)
                {
                sessionError(err);             
                }
            }
            
