                function getNavatarSetupData()
                {
                   try
                    {    
                        var query="select id, "+Namespaceprefix1+"IFC_Setting__c FROM "+Namespaceprefix1+"Navatar_Setup__c where OwnerId = '{!$User.Id}' ";    
                        var resultdesc = sforce.connection.query(query);         
                        var recsize = resultdesc.getArray("size");                      
                        if(recsize == 0)
                        {                            
                            MainGridFilds = MainGridFildsDefalut;
                        }
                        else{
                            var recordsdesc = resultdesc.getArray("records");                
                            var CommitFieldValues = recordsdesc[0].get(Namespaceprefix1+'IFC_Setting__c');
                            if(CommitFieldValues != '' && CommitFieldValues != null){
                                if(CommitFieldValues.indexOf('fundview:') > -1){
                                    var gridFields = CommitFieldValues.split('fundview:')[1]; 
                                    
                                    if(gridFields != '' || gridFields != null){
                                        MainGridFilds = gridFields.split(',');
                                    }
                                    else{
                                        MainGridFilds = MainGridFildsDefalut;
                                    }
                                }
                                else{
                                    MainGridFilds = MainGridFildsDefalut;
                                }
                            }
                            else{
                                MainGridFilds = MainGridFildsDefalut;
                            }   
                        }
                        
                        for(i = MainGridFildsDefalut.length-1;i>=0;i--){
                            var tempField = MainGridFildsDefalut[i].split(':');
                            
                            if(tempField[0] == Namespaceprefix1+'Commitment__c'){
                                if(commitmentApi.indexOf(tempField[1]) == -1){
                                    MainGridFildsDefalut.splice(i,1);
                                }
                                else{
                                    if (CommitmentLabelSecurity.indexOf(tempField[2]) == -1){
                                        tempField[2] = CommitmentLabelSecurity[commitmentApi.indexOf(tempField[1])];
                                        MainGridFildsDefalut[i] = tempField[0]+':'+tempField[1]+':'+tempField[2]+':'+tempField[3];
                                    }
                                }
                            }
                            else if(tempField[0] == Namespaceprefix1+'Partnership__c'){
                                if(partnershipApi.indexOf(tempField[1]) == -1){
                                    MainGridFildsDefalut.splice(i,1);
                                }
                                else{
                                    if (PartnershipLabelSecurity.indexOf(tempField[2]) == -1){
                                        tempField[2] = PartnershipLabelSecurity[partnershipApi.indexOf(tempField[1])];
                                        MainGridFildsDefalut[i] = tempField[0]+':'+tempField[1]+':'+tempField[2]+':'+tempField[3];
