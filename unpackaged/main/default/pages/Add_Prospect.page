                                return false;
                            }                    
                             else if(PrimaryArray1[0].errorCode == "NOT_IMPLEMENTED")
                            {                              
                                summarytabular();
                                document.getElementById('loadprogress').style.display = 'none';                                
                                return false;
                            }
                            else
                            {
                            document.getElementById('onethousand').innerHTML=PrimaryArray1[0].message
                            onethousandErrors_PopUp();
                            document.getElementById('loadprogress').style.display = 'none';
                            return false;
                            
                            }
                        }catch(err)
                        {                       
                            PrimaryArray1 = JSON.parse(dataparse); 
                            index = PrimaryArray1.reportMetadata.sortBy; 
                            sortedindex=index.length;
                            if(index.length>0)
                            {
                            SortColumn=index[0].sortColumn;
                            SortOrder=index[0].sortOrder;
                            var Reportmeta= PrimaryArray1.reportExtendedMetadata.detailColumnInfo;                     
