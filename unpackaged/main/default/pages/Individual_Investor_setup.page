            // (SK: 1Nov2017)
            function HTMLEncode1(str)
            {
                str = str.split("amp;").join("");
                str = str.split("&#39;").join("'");
                var i = str.length,
                aRet = [];
            
                while (i--) 
                {
                    var iC = str[i].charCodeAt();
                    if (iC < 65 || iC > 127 || (iC>90 && iC<97)) 
                    {
                        aRet[i] = '&#'+iC+';';
                    } 
                    else 
                    {
                        aRet[i] = str[i];
                    }
                }
                return aRet.join('');    
            }
            
