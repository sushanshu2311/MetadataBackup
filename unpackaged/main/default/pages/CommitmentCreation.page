            <script>
            $(document).ready(function(){
                var sourceCompany = '{!JSENCODE(strCompanyDiv)}';
                var inSufficentPopup = '{!if(isInSufficient==true,'true','false')}';
                var isMobile = '{!JSENCODE(IF(isMobile==true,'true','false'))}'; // to check if the device is mobile, added by Aditya PEv4.7 8 July 2021
                if(isMobile == true || isMobile =='true')
                {
                    InsufficientPermissions_Fancybox();
                    document.getElementById('ErrorPopupTextId').innerHTML ='This functionality is not accessible through Mobile App, please use Desktop App to access it.'; 
                 }
                $('.div_a').show();
                $('.div_b').hide();
                
                $(".click_one").click(function(){
                    $('.div_a').hide();
                    $('.div_b').show();
                });
                
                $(".click_Two").click(function(){
                    $('.div_a').show();
                    $('.div_b').hide();
                });
                if(inSufficentPopup == true || inSufficentPopup =='true')
                {
                    InsufficientPermissions();
                }
                if({!isOrgSetting} == false)
                 {
                  InsufficientPermissions_Fancybox();
                  document.getElementById('ErrorPopupTextId').innerHTML ='You cannot access this functionality. Functionality may be disabled.<br/> Please contact Navatar administrator.'; 
                 }
                else if({!isAdminSetting} == false) 
                {
                    ErrorOccuredPopup();
                }
                else if({!isFieldPermission} == true)
                {
                 InsufficientPermissions_Fancybox();
                }
                else
                {
                    sforce.connection.sessionId = "{!$Api.Session_ID}";
                    result = sforce.connection.describeLayout('Account',null,null);
                    var ObjectPartnershipName = nameSpace+'Partnership__c';
                    resultPartnership = sforce.connection.describeLayout(ObjectPartnershipName.toLowerCase(),null,null);
                    var ObjectCommitmentName = nameSpace+'Commitment__c';
                    resultCommitment = sforce.connection.describeLayout(ObjectCommitmentName.toLowerCase(),null,null);
