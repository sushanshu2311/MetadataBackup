        function checkmassmail()
            {            
               try
                {
                   document.getElementById('loadprogress').style.display = 'block';
                   document.getElementById('blurred').style.display='block';
                   
                   try
                       {
                            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.EmailProspect_Ctlr.GetEmailLimit}',
                            function(result, event)
                            {                                                    
                               if(event.status)
                               {  
                                                             
                                    var limtresult="";                          
                                    limtresult=result.replace(/\&lt\;/g,'<').replace(/\&lt\;/g,'<').replace(/\&gt\;/g,'>').replace(/\&amp\;/g,'&').replace(/&#39;/g, "'").replace(/\&quot\;/g, '"');                
                                    
                                    var Maildata=JSON.parse(limtresult);                                   
                                    RemainingEmailLimit=Maildata['SingleEmail'].Remaining;
                                    


                                    if(parseInt(RemainingEmailLimit) <= 0)
                                    {
                                        ErrorEmailLimit_Fancybox();
                                        document.getElementById('loadprogress').style.display = 'none'; 
                                    }
                                    else
                                    {
                                    
                                        if(RemainingEmailLimit >= arrObjSelectedRows.length)
                                        {
                                        arrObjSelectedRows.id= allSelectedContactId;
                                        
                                            $("#btnstep3up").removeAttr("onclick");
                                            $("#btnstep3below").removeAttr("onclick");
                                            document.getElementById('pageid:frm:ol2').innerHTML="";
                                            document.getElementById('pageid:frm:ol22').innerHTML="";
                                            var sendmailerror = document.getElementById('pageid:frm:Propcongrid').value;   
                                            sendmassmail(allSelectedContactId);
                                                                           
                                        }
                                        else
                                        {
                                            var limitrem=arrObjSelectedRows.length - RemainingEmailLimit;
                                            
                                            document.getElementById('EmailLimitShow').innerHTML= 'This mass email cannot be sent today as your daily limit has only '+RemainingEmailLimit+' emails remaining. If you are going to send today go back and select '+RemainingEmailLimit+' or fewer recipients.';
                                            ErrorEmailLimitRemaining_Fancybox();
                                            document.getElementById('loadprogress').style.display = 'none';
                                        }
                                    }
                                }
                                else if (event.statusCode != 200) 
                                {  
                                   alert('Something went worng plz refresh the page');
                                }  
                              
                            } 
                        );
                                                 
                    
                       }
                       catch(ex)
                       {
                            if(ex.faultcode == 'sf:INVALID_SESSION_ID'  )
                            {
                                alert('Your session has expired. Please refresh your page.');
                            }
                      }
                      
                    
