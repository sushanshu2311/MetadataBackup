        <script type="text/javascript">
            var popupStatus = 0;  
            var strFundrasingRightColField = '';        //store fundrasing object right column field api
            var strFundrasingLeftColField = '';         //store fundrasing object left column field api
            var arrFundrasingRightColFieldIndex = [];   //store fundrasing section right column value index 
            var arrFundrasingLeftColFieldIndex = [];    //store fundrasing section left column value index  
            var strCommitmentRightColField = '';        //store commitment object right column field api
            var strCommitmentLeftColField = '';         //store commitment object left column field api
            var arrCommitmentRightColFieldIndex = [];   //store commitment section right column value index 
            var arrCommitmentLeftColFieldIndex = [];    //store commitment section left column value index  
            var strInstitutionLeftColField = '';        //store institution object right column field api
            var arrInstitutionLeftColFieldIndex = [];   //store institution object right column field api   
            var strPartnershipLeftColField = '';        //store partnership object right column field api
            var arrPartnershipLeftColFieldIndex = [];   //store partnership object right column field api 
            var selectedValueAtLast ='';                //store selected input column field value           
            var strFindDuplicateValue = '';             //contions all field api on page and used for check if duplicate value is found
            var isDuplicateValueFound = '';             //used for check if duplicate value is found

            //Used for save commitment setup page fields api to navatar setup object.
            function saveCommitmentSetupLayout()
            { 
                var strContentData = '';
                var j=0;    
                isDuplicateValueFound = false;              
                strFundrasingLeftColField = '';
                strFundrasingRightColField = '';
                strCommitmentLeftColField = '';
                strInstitutionLeftColField = '';                
                strInstitutionLeftColField = '';
                strCommitmentRightColField = '';
                strPartnershipLeftColField = '';
                strFindDuplicateValue = '';
                strFundrasingLeftColField = ''+strNameSpace+'Fundraising__c:Name,'+strNameSpace+'Fundraising__c:'+strNameSpace+'Legal_Name__c';
                strFundrasingLeftColField = strFundrasingLeftColField.toLowerCase();
                strFundrasingRightColField = ''+strNameSpace+'Fundraising__c:'+strNameSpace+'Fund_Name__c,navpeII_dev18l__Fundraising__c:'+strNameSpace+'Portfolio_Company__c';
                strFundrasingRightColField = strFundrasingRightColField.toLowerCase();                              
                strCommitmentLeftColField = strCommitmentLeftColField.toLowerCase();
                strInstitutionLeftColField = 'Account:Name';
                strInstitutionLeftColField = strInstitutionLeftColField.toLowerCase();
                strPartnershipLeftColField = ''+strNameSpace+'Partnership__c:'+strNameSpace+'Fund__c,'+strNameSpace+'Partnership__c:Name';
                strPartnershipLeftColField = strPartnershipLeftColField.toLowerCase();
                
                strFindDuplicateValue = strFundrasingLeftColField.toLowerCase()+','+strFundrasingRightColField.toLowerCase();
                //used for fundrasing information left column
                while (j<arrFundrasingLeftColFieldIndex.length) {                                    
                    var strInputFieldId = 'fundraisinginputleftcolmn'+arrFundrasingLeftColFieldIndex[j]+'';                    
                    var inputColmnVal = document.getElementById("fundraisinginputleftcolmn"+arrFundrasingLeftColFieldIndex[j]+"").value;
                    
                    if(inputColmnVal.length>0){
                        var inputText = '';
                    
                        if(mapInputFieldIdVsFieldLabel[strInputFieldId]!=undefined){   
                            inputText = mapInputFieldIdVsFieldLabel[strInputFieldId];
                        }else{
                            inputText ='';
                        }               
                        if(mapFieldLabelVsApi[inputText]!=undefined){
                            if(strFindDuplicateValue.indexOf(mapFieldLabelVsApi[inputText].toLowerCase())>-1){                                        
                                isDuplicateValueFound = true;
                                document.getElementById('duplicateErr').style.display = 'block';
                                document.getElementById('fancyboxdiv').style.display = 'block';                         
                            }else{
                                strFindDuplicateValue = strFindDuplicateValue +','+ mapFieldLabelVsApi[inputText].toLowerCase();
                            }
                        }                                    
                        if(inputText.length >0 && inputText!=undefined){
                                               
                           if(strFundrasingLeftColField.length==0){
                                                                    
                                if(mapFieldLabelVsApi[inputText]!=undefined)                                            
                                strFundrasingLeftColField = mapFieldLabelVsApi[inputText]; 
                            }else{
                                if(inputText!=undefined){
                                    if(mapFieldLabelVsApi[inputText]!=undefined)               
                                        strFundrasingLeftColField = strFundrasingLeftColField +','+mapFieldLabelVsApi[inputText];
                                }
                            }  
                        }
                    }
                    j++;
                }
             
                j=0;              
