                    try
                    {    
                        if(strToChange != null || strToChange != '')
                            return strToChange.replace('<br>','').replace(/&#60;/g,'<').replace(/&#62;/g,'>').replace('&','&amp;').replace('\'','&#39;').replace(',','&#44;').replace('/','&#47;').replace('^','&#94;').replace('_','&#95;').replace('`','&#96;').replace('~','&#126;').replace('$','&#36;').replace('!','&#33;').replace('%','&#37;').replace('*','&#42;').replace('?','&#63;').replace(':','&#58;').replace('|','&#124;').replace('+','&#43;').replace('=','&#61;').replace('[','&#91;').replace(']','&#93;').replace('{','&#123;').replace('}','&#125;').replace('\\','&#92;').replace('€','&#128;').replace('£','&#163;');
                        else
