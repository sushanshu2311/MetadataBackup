                            for(var i=0 ; i < (negativeVal.length - 1) ; i++)
                            {
                                if(i == (negativeVal.length - 2))
                                    error1 += negativeVal[i]+' ';
                                else
                                    error1 += negativeVal[i]+', ';
                            }
                            error1 += 'and ' + negativeVal[negativeVal.length - 1];
                        }
                        else if(negativeVal.length == 1)
