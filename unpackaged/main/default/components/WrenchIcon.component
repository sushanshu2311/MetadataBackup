            document.getElementById('clearsearchdsb1{!componentID}').style.display = 'block';
            document.getElementById('clearsearchenb1{!componentID}').style.display = 'none';
        }
        var wrenchiconId='';
        function show_wrenchpopup_page{!componentID}()
        {
            try
            {   
               
                if("{!UsingPageName}" == "CMF_PFC" || "{!UsingPageName}" == "CMF_PFA")
                {
                    MainGridFilds = MainGridFildsPFC;
                    MainGridFildsDefalut = MainGridFildsDefalutPFC;
                }
                else if("{!UsingPageName}" == "CMF" )
                {
                    MainGridFilds = MainGridFildsAC;
                    MainGridFildsDefalut = MainGridFildsDefalutAC;
                }
               
                wrenchiconId = '{!JSENCODE(componentID)}';           // SK: 11Dec2017
                var objList = '{!JSENCODE(Objects)}'.split(':');    // SK: 11Dec2017
                var blankOption = document.getElementById('objectSelected{!componentID}').innerHTML = '';  
                var sel = document.getElementById('objectSelected{!componentID}');
                opt = document.createElement('option');
                opt.innerHTML = 'All Fields';
                opt.value = 'all';
                sel.appendChild(opt);
                for(var i = 0; i < objList.length; i++) {
                    if(objList[i].indexOf('__c') > -1 ){
                    }
                    opt = document.createElement('option');
                    if(objList[i] == 'Commitment__c'){
                        opt.innerHTML = 'Commitment Fields';
                        opt.value = Namespaceprefix1+'Commitment__c';
                    }
                    else if(objList[i] == 'Partnership__c'){
                        opt.innerHTML = 'Partnership Fields';
                        opt.value = Namespaceprefix1+'Partnership__c';
                    }
                    else if(objList[i] == 'Fundraising_Contact__c'){
                        opt.innerHTML = 'Fundraising Contact Fields';
                        opt.value = Namespaceprefix1+'Fundraising_Contact__c';
                    }
                    else if(objList[i] == 'Fundraising__c'){
                        opt.innerHTML = 'Fundraising Fields';
                        opt.value = Namespaceprefix1+'Fundraising__c';
                    }
                    else if(objList[i] == 'Account'){
                        opt.innerHTML = 'Account Fields';
                        opt.value = objList[i];
                    }
                    else if(objList[i] == 'Contact'){
                        opt.innerHTML = 'Contact Fields';
                        opt.value = objList[i];
                    }
                    else if(objList[i] == 'Investor_Distribution__c'){
                        opt.innerHTML = 'Investor Distribution Fields';
                        opt.value = Namespaceprefix1+'Investor_Distribution__c';
                    }
                    else if(objList[i] == 'Capital_Call__c'){
                        opt.innerHTML = 'Capital Call Fields';
                        opt.value = Namespaceprefix1+'Capital_Call__c';
                    }
                    else if(objList[i] == 'Marketing_Prospect__c'){
                        opt.innerHTML = 'Marketing Prospect Fields';
                        opt.value = Namespaceprefix1+'Marketing_Prospect__c';
                    }
                    sel.appendChild(opt);
                }
                
                var results = sforce.connection.describeSObject(Namespaceprefix1+"Navatar_Setup__c");
               
                if((results.createable != "false") &&  (results.updateable != "false"))
                {
                    for (var i=0; i<results.fields.length; i++) 
                    {
                        var field = results.fields[i];
                        // Added a Logic to check all the security properties of object and related fields
                        if((field.name == Namespaceprefix1+"CMF_Setting__c") && ("{!UsingPageName}" == "CMF")){
                            if(field.createable=='false') {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                            else if(checkWrenchIcon_field('CMF')){
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                        }
                        //Sumitab added Code Start.
                        if((field.name == Namespaceprefix1+"CMF_PFC_Setting__c") && ("{!UsingPageName}" == "CMF_PFC")){
                            if(field.createable=='false') {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                            else if(checkWrenchIcon_field('CMF_PFC')){
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                        }
                        if((field.name == Namespaceprefix1+"CMF_PFA_Setting__c") && ("{!UsingPageName}" == "CMF_PFA")){
                            if(field.createable=='false') {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                            else if(checkWrenchIcon_field('CMF_PFA')){
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                        }
                        //Sumitab Code Ended.
                        
                        else if((field.name == Namespaceprefix1+"MMF_Results_Settings__c") && ("{!UsingPageName}" == "MEF")){
                           
                            if(field.createable=='false')
                            {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                          
                            else if(checkWrenchIcon_field())
                             {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                        }
                         else if((field.name == Namespaceprefix1+"Add_Prospect_Setting__c") && ("{!UsingPageName}" == "AP")){
                            if(field.createable=='false')
                            {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                          
                            else if(checkWrenchIcon_field())
                            {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                        }
                        else if((field.name == Namespaceprefix1+"IFC_Setting__c") && ("{!UsingPageName}" == "ICG")){
                            if(field.createable=='false')
                            {
                                InsufficientPrivlagesError{!componentID}();
                                return null;
                            }
                          
                            else if(checkWrenchIcon_field())
                            {
