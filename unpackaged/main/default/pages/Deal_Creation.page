            {
                if(event.status) {
                
                  try 
                  { 
                        var responseResult = result.split('*?');
                        var arrRecordType = responseResult[0].split('~');    //to get object
                        
                        var erroMesg = responseResult[1];                   
                        if(erroMesg.length>40){
