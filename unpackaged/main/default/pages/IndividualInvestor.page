                        arrObjRequiredFeild = strRequiredFeild;
                    }
                    else
                    {                      
                        arrObjRequiredFeild = arrObjRequiredFeild+','+strRequiredFeild;                 
                    }                    
                }           
                
                CheckRequiredStatusOfStaticFields();
                AssignRequiredFieldtoString(arrObjRequiredFeild);
            }
            document.getElementById("loadingDiv").style.display="none";
        });

        /*@Description:It Checks Required Status Of Static Fields*/
        function CheckRequiredStatusOfStaticFields()
        {
            
            /*Description Check*/
            if(arrObjRequiredFeild.indexOf('Contact:Description') > -1 || arrObjRequiredFeild.indexOf('contact:description') > -1)
                document.getElementById("reqDescId").style.display="";
            
            /*Phone Check*/
            if(arrObjRequiredFeild.indexOf('Contact:Phone') > -1 || arrObjRequiredFeild.indexOf('contact:phone') > -1)
                document.getElementById("reqPhoneId").style.display="";
            
            /*Fax Check*/
            if(arrObjRequiredFeild.indexOf('Contact:Fax') > -1 || arrObjRequiredFeild.indexOf('contact:fax') > -1)
                document.getElementById("reqFaxId").style.display="";
            
            /*Mobile Phone Check*/
            if(arrObjRequiredFeild.indexOf('Contact:MobilePhone') > -1 || arrObjRequiredFeild.indexOf('contact:mobilephone') > -1)
                document.getElementById("reqMPhoneId").style.display="";
            
            /*Email Check*/
            if(arrObjRequiredFeild.indexOf('Contact:Email') > -1 || arrObjRequiredFeild.indexOf('contact:email') > -1)
                document.getElementById("reqEmailId").style.display="";
            
            document.getElementById('loadingDiv').style.display='none';
        }
                
        /*It will the required field according to the layout.*/
        function gerRequiredFeildsOnPageLayout(ObjectName, RecordTypeId)   // it will return required field of passed obj n recordType id
        {
            var apinames_req='';         // this will contain fields which are visible as required on pagelayout                
            var apinames_readOnly='';    // this will contain fields which are readonly on pagelayout                
            var apinames = '';           // this will contain fields visible on pagelayout
            var apiNameArray= new Array();
            
            var resultLayout = sforce.connection.describeLayout(ObjectName, new Array(RecordTypeId));
            var layout = resultLayout.getArray("layouts")[0];
             
            var elSections = layout.getArray("editLayoutSections");
             
            for (var j = 0; j < elSections.length; j++) 
            {
                var els = elSections[j];
                var allTheLayoutRows = els.getArray("layoutRows");
               
                for (var k = 0; k < allTheLayoutRows.length; k++) 
                {
                    var lr = allTheLayoutRows[k];
                    var lis = lr.getArray("layoutItems");
                    for (var h = 0; h < lis.length; h++) 
                    {
                        var li = lis[h];
                        if (li.layoutComponents != null && li.layoutComponents.length == 2)     //only in case of Lead and Contact First Name, which includes Salutation also
                        {
                            if(apiNameArray.indexOf(li.layoutComponents[1].value)=='-1')
                            {
                                apinames+= li.layoutComponents[1].value + ',';
                                apiNameArray.push(li.layoutComponents[1].value);
                            }
                            if(apinames_req.indexOf(li.layoutComponents[1].value)=='-1')
                            {
                                if(li.required==true || li.required=='true')
                                apinames_req+=ObjectName+':'+li.layoutComponents[1].value +',';
                            }
                            if(apinames_readOnly.indexOf(li.layoutComponents[1].value)=='-1')
                            {
                                if(li.editable==false || li.editable=='false')
                                apinames_readOnly+=li.layoutComponents[1].value +',';
                            }
                        }                            
                        else if (li.layoutComponents != null)           //for all other fields
                        {
                            if(apiNameArray.indexOf(li.layoutComponents.value)=='-1')
                            {
                                if(li.required==true || li.required=='true')
                                    apinames_req+=ObjectName+':'+li.layoutComponents.value +',';
                                if(li.editable==false || li.editable=='false')
                                    apinames_readOnly+=li.layoutComponents.value +',';
                                apinames+= li.layoutComponents.value + ',';
                                apiNameArray.push(li.layoutComponents.value);
                            }
                        }
                    }
                }
            }
            
            var readOnlySections = layout.getArray("detailLayoutSections");
            for (var j = 0; j < readOnlySections.length; j++) 
            {
                var els = readOnlySections[j];
                var allTheLayoutRows = els.getArray("layoutRows");
                for (var k = 0; k < allTheLayoutRows.length; k++) 
                {
                    var lr = allTheLayoutRows[k];
                    var lis = lr.getArray("layoutItems");
                    for (var h = 0; h < lis.length; h++) 
                    {
                        var li = lis[h];                        
                        if (li.layoutComponents != null)           //for all other fields
                        {
                            if(apiNameArray.indexOf(li.layoutComponents.value)=='-1')
                            {
                                if(li.layoutComponents.value!=null){
                                    apinames_readOnly+=li.layoutComponents.value +',';
                                    apiNameArray.push(li.layoutComponents.value);
                                }
                            }
                        }
                    }
                }
            }  
            return [apinames_req];
        }
        
