                /*@Logic: Create MAP of Left Selected values; IndexVsValues. */
                var arrForFinalInsertLeft = stringToMaintainSectionLeft.split('@');
                for(var i=0; i <= arrForFinalInsertLeft.length; i++)
                {
                    if(i == 0) /*arrForFinalInsertLeft; this array doesn't have zero(0), so we need to extract value from Map, which has a key 0.*/
                        finalStringB4SaveLft = mapFieldIndexVsValueLft[ "0" ]; 
                    if(arrForFinalInsertLeft[i] != undefined && mapFieldIndexVsValueLft[ arrForFinalInsertLeft[i] ] != undefined)
                    {
                        if(finalStringB4SaveLft == '')
                            finalStringB4SaveLft = mapFieldIndexVsValueLft[ arrForFinalInsertLeft[i] ];
                        else
                            finalStringB4SaveLft =  finalStringB4SaveLft + ',' + mapFieldIndexVsValueLft[ arrForFinalInsertLeft[i] ];
                    }
                }
                
                /*@Logic: Create MAP of Right Selected values; IndexVsValues. */
                var arrForFinalInsertRight = stringToMaintainSectionRight.split('@');
                for(var i=0; i <arrForFinalInsertRight.length; i++)
                {
                    if(i == 0) /*arrForFinalInsertLeft; this array doesn't have zero(0), so we need to extract value from Map, which has a key 0.*/
                        finalStringB4SaveRyt = mapFieldIndexVsValueRyt[ "0" ]; 
                    if(arrForFinalInsertRight[i] != undefined && mapFieldIndexVsValueRyt[ arrForFinalInsertRight[i] ] != undefined)
                    {
