                if(document.getElementById(thisIs.id).value == '' && strid.indexOf("Institution")>-1)
                {
                    jQuery('#'+thisIs.id).removeClass( "icon_33LightAcc" );
                }
                
                if(document.getElementById(thisIs.id).value == '' && strid.indexOf("partnership")>-1)
                {
                    jQuery('#'+thisIs.id).removeClass( "icon_33LightPartnership" );
                }
            }       
            
