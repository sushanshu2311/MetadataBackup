        <script type="text/javascript">
            var strCommitmentList =[];      //contaions commitment object fields api
            var strFundraisingList =[];     //contaions fundraising object fields api
            var strAccountList =[];         //contaions account object fields api
            var strPartnershipList =[];     //contaions partnership object fields api   

            var mapInputFieldIdVsFieldLabel = {};  //used to map sobject fields api and label
            var strNameIds = '';                    //store the input column id
            var defaultFieldApi = '{!lstDefaultField}';           
            defaultFieldApi = defaultFieldApi.toLowerCase();
                     
            var strNameSpace = '{!JSENCODE(strNameSpace)}';         //store org namespace
            var strCommitmentObj= strNameSpace+'Commitment__c:';    //store commitment object api name
            strCommitmentObj = strCommitmentObj.toLowerCase();
            var strFundrasingObj= strNameSpace+'Fundraising__c:';   //store fundraising object api name
            strFundrasingObj = strFundrasingObj.toLowerCase();
            var strAccountObj= 'Account:';                          //store account object api name
            strAccountObj = strAccountObj.toLowerCase();
            var strPartnershipObj= strNameSpace+'Partnership__c:';  //store commitment object api name
            strPartnershipObj = strPartnershipObj.toLowerCase();
            var mapFieldLabelVsApi = {};                            //used to map sobject fields label and api name
            var mapApiVsFieldLabel = {};                            //used to map object and field api with field label name
            var mapApiVsObjFieldLabel = {};                         //used to map field api with field label name            
            
            <apex:repeat value="{!FieldLabelVsApi}" var="lst"> 
                var strMapKey = '{!JSENCODE(lst)}';                  //store field api name     
                strMapKey = strMapKey.toLowerCase();
                var strMapValue= '{!JSENCODE(FieldLabelVsApi[lst])}';       //store field label name
                mapFieldLabelVsApi[""+strMapValue+""] = ""+strMapKey+"";
                mapApiVsObjFieldLabel[""+strMapKey+""] = ""+strMapValue+"";
                if(strMapValue.length >0 && strMapValue.indexOf(':') > -1){
                    strMapValue = strMapValue.split(':');
                    strMapValue = strMapValue[1];
                }
                mapApiVsFieldLabel[""+strMapKey+""] = ""+strMapValue+"";
                
                if(strMapKey.indexOf(strFundrasingObj)> -1){
                    if(defaultFieldApi.indexOf(strMapKey.toLowerCase())==-1)
                        strFundraisingList.push('{!JSENCODE(FieldLabelVsApi[lst])}');
                }
                else if(strMapKey.indexOf(strCommitmentObj)>-1){   
                    if(defaultFieldApi.indexOf(strMapKey.toLowerCase())==-1 && strMapKey.toLowerCase().indexOf(''+strCommitmentObj+''+strNameSpace.toLowerCase()+'fundraising__c')==-1)
                        strCommitmentList.push('{!JSENCODE(FieldLabelVsApi[lst])}'); 
                }
                else if(strMapKey.indexOf(strPartnershipObj)>-1){   
                    if(defaultFieldApi.indexOf(strMapKey.toLowerCase())==-1)
                        strPartnershipList.push('{!JSENCODE(FieldLabelVsApi[lst])}');
                }
                else if(strMapKey.indexOf(strAccountObj)>-1){   
                    if(defaultFieldApi.indexOf(strMapKey.toLowerCase())==-1 && strMapKey.toLowerCase().indexOf('account:parentid')==-1)
                        strAccountList.push('{!JSENCODE(FieldLabelVsApi[lst])}');
                }                
            </apex:repeat>  
        </script>
        
