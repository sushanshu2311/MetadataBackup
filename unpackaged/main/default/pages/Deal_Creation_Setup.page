                <script>
                    var strNameIds = ''; 
                    var mapInputFieldIdVsFieldLabel = {};
                    var strAccountLabel = '{!$ObjectType.Account.Label}';
                    var strContactLabel = '{!$ObjectType.Contact.Label}';
                    var strPipelineLabel = '{!$ObjectType.Pipeline__c.Label}';
                    
                    //utility for add icon in column
                    function jQueryUtilityOfAutoComplete(nameIs, arrList)
                    {                        
                        var getLocalId='';
                        j$(document).ready(function()
                        {
                            $("input[name^='"+nameIs+"']").autocomplete({
                                minLength: 0,
                                source: arrList,
                                
                                focus: function (event, ui) 
                                {
                                    if(event.keyCode ==38 || event.keyCode ==40 || event.keyCode ==13)
                                    {   
                                        var showSelected = ui.item.value;
                                     
                                        var labell = ui.item.label;
                                        $(this).each(function() 
                                        {
                                            $.each(this.attributes, function() 
                                            {
                                                if(this.name == 'id')    /*It will give you the value of clicked input text fields.*/
                                                    getLocalId = this.value;
                                            });
                                        });                                         
                                        if(showSelected.indexOf(strAccountLabel+':') > -1 )
                                        {
                                            selectedValueAtLast = showSelected.substring(showSelected.indexOf(strAccountLabel+':')+strAccountLabel.length+1, showSelected.length);
                                            jQuery('#'+getLocalId).addClass( "icon_33LightAccount" );
                                            ui.item.value = selectedValueAtLast;
                                        }
                                        else if(showSelected.indexOf(strContactLabel+':') > -1 )
                                        {
                                            selectedValueAtLast = showSelected.substring(showSelected.indexOf(strContactLabel+':')+strContactLabel.length+1, showSelected.length);
                                            jQuery('#'+getLocalId).addClass( "icon_33LightContact" );
                                            ui.item.value = selectedValueAtLast;
                                        }
                                        else if(showSelected.indexOf(strPipelineLabel+':') > -1 )
                                        {
                                            selectedValueAtLast = showSelected.substring(showSelected.indexOf(strPipelineLabel+':')+strPipelineLabel.length+1, showSelected.length);
                                            jQuery('#'+getLocalId).addClass( "icon_33LightPipeline" );
                                            ui.item.value = selectedValueAtLast;
                                        }
                                        if(getLocalId.length >0)
                                        {    
                                            mapInputFieldIdVsFieldLabel[""+getLocalId+""] = ""+ui.item.label+"";
                                        }
                                    }
                                },
                                
                                select: function( event, ui )
                                {   
                                    var showSelected = ui.item.value;
                                   
                                    var labell = ui.item.label;
                                    $(this).each(function() 
                                    {
                                        $.each(this.attributes, function() 
                                        {
                                            if(this.name == 'id')    /*It will give you the value of clicked input text fields.*/
                                                getLocalId = this.value;
                                        });
                                    });                                         
                                     if(showSelected.indexOf(strAccountLabel+':') > -1 )
                                    {
                                        selectedValueAtLast = showSelected.substring(showSelected.indexOf(strAccountLabel+':')+strAccountLabel.length+1, showSelected.length);
                                        jQuery('#'+getLocalId).addClass( "icon_33LightAccount" );
                                        ui.item.value = selectedValueAtLast;
                                    }
                                    else if(showSelected.indexOf(strContactLabel+':') > -1 )
                                    {
                                        selectedValueAtLast = showSelected.substring(showSelected.indexOf(strContactLabel+':')+strContactLabel.length+1, showSelected.length);
                                        jQuery('#'+getLocalId).addClass( "icon_33LightContact" );
                                        ui.item.value = selectedValueAtLast;
                                    }
                                    else if(showSelected.indexOf(strPipelineLabel+':') > -1 )
                                    {
                                        selectedValueAtLast = showSelected.substring(showSelected.indexOf(strPipelineLabel+':')+strPipelineLabel.length+1, showSelected.length);
                                        jQuery('#'+getLocalId).addClass( "icon_33LightPipeline" );
                                        ui.item.value = selectedValueAtLast;
                                    }
                                    if(getLocalId.length >0)
                                    {    
                                        mapInputFieldIdVsFieldLabel[""+getLocalId+""] = ""+ui.item.label+"";
                                    }
                                }
                               
                            }).focus(function ()  /*focus: it works on click of input text.*/
                            {                 
                                $(this).autocomplete("search", "");
                                                            
                            }).data("ui-autocomplete")._renderItem = function (ul, item) 
                            {                               
                                var myItem = item.value;                                
                                myItem = myItem.replace(/&/g, "&amp;").replace(/>/g, "&gt;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
                            
                                if(myItem.indexOf(strAccountLabel+':') > -1 )                                             
                                {                        
                                    var str = myItem.substring(myItem.indexOf(strAccountLabel+':')+strAccountLabel.length+1, myItem.length);                                   
                                    var listItem = $("<li></li>").data("item.autocomplete", item).append("<a class='myaccount_cls'>" + "<input type=hidden value="+ myItem +" />" + str + "</a>").appendTo(ul);
                                } 
                                else if(myItem.indexOf(strContactLabel+':') > -1)
                                {
                                    var str = myItem.substring(myItem.indexOf(strContactLabel+':')+strContactLabel.length+1, myItem.length);
                                    var listItem = $("<li></li>").data("item.autocomplete", item).append("<a class='mycontact_cls'>" + "<input type=hidden value="+ myItem +" />" + str + "</a>").appendTo(ul);
                                }
                                else if(myItem.indexOf(strPipelineLabel+':') > -1)
                                {
                                    var str = myItem.substring(myItem.indexOf(strPipelineLabel+':')+strPipelineLabel.length+1, myItem.length);
                                    var listItem = $("<li></li>").data("item.autocomplete", item).append("<a class='mypipeline_cls'>" + "<input type=hidden value="+ myItem +" />" + str + "</a>").appendTo(ul);
                                }                                
                                return listItem;
                            };
                        });
                    }
                    
