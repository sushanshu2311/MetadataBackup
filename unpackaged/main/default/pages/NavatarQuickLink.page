<apex:page controller="NavatarQuickLink_ctr">
    <link href = "{!URLFOR($Resource.SLDS100, 'assets/styles/salesforce-lightning-design-system-vf.css')}" rel = "stylesheet" type = "text/css"/>
      <!--script src="/soap/ajax/28.0/connection.js" type="text/javascript"></script>
     <script src="/soap/ajax/28.0/apex.js" type="text/javascript"></script-->
  <html style="{!IF(isLightningModeOff=true,'', 'margin-top: -32px;')}">
    
      <style>
         body.sfdcBody.apexPageInline {margin:0; padding:0;}
          #sidebarDiv .sidebarModule .sidebarModuleBody {padding: 12px 5px 10px !important;}
        
          .NavatarQuickLink_Sec { }
          .NavatarQuickLink_Sec ul,li { margin:0; padding:0; list-style:none; }
          .NavatarQuickLink_Sec ul li { margin:0; }
          .NavatarQuickLink_Sec ul li a {padding:4px 0px 4px 0px !important; border-radius:5px;  display:block; /*padding-left:22px; background:url(https://ap2.salesforce.com/img/sprites/master.png) top 4px left no-repeat;*/ }          
          /*.NavatarQuickLink_Sec ul li a.fundraising { background:url(https://ap2.salesforce.com/img/icon/sun16.png) top 4px left no-repeat; }
          .NavatarQuickLink_Sec ul li a.email { background:url(https://ap2.salesforce.com/img/icon/sun16.png) top 4px left no-repeat; }
          .NavatarQuickLink_Sec ul li a.deal { background:url(https://ap2.salesforce.com/img/icon/sun16.png) top 4px left no-repeat; }
          .NavatarQuickLink_Sec ul li a.investor { background:url(https://ap2.salesforce.com/img/icon/sun16.png) top 4px left no-repeat; }
          .NavatarQuickLink_Sec ul li a.Commitment { background:url(https://ap2.salesforce.com/img/icon/sun16.png) top 4px left no-repeat; }
