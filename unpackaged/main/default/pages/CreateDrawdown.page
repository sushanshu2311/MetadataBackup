            function chkChar(e)
            {
              //alert(e.which);
              if( e.which!=8 && e.which!=46 && e.which!=0 && (e.which<48 || e.which>57))
              {
                return false;
              }               
              return true;
            }

            function noCopyKey(e) {
                var forbiddenKeys = new Array('c','x','v');
                var keyCode = (e.keyCode) ? e.keyCode : e.which;
                var isCtrl;
        
        
                if(window.event)
                    isCtrl = e.ctrlKey
                else
                    isCtrl = (window.Event) ? ((e.modifiers & Event.CTRL_MASK) == Event.CTRL_MASK) : false;
            
        
                if(isCtrl) {
                    for(i = 0; i < forbiddenKeys.length; i++) {
                        if(forbiddenKeys[i] == String.fromCharCode(keyCode).toLowerCase()) {
                            //alert('You are prompted to type this twice for a reason!');
                            return false;
                        }
                    }
                }
                return true;
            }  
    
            function DateTrim(Obj)
            {
                Obj.value = removeSpace(Obj.value);
                Obj.value = removeOtherChar(Obj.value);
            }
            
            function removeOtherChar(str)
            {
                var tempStr = '';
                for(var i = 0 ; i < str.length ; i++)
                {
                    var charVal = str.substring(i,i+1);
                    if(charVal == '0' || charVal == '1' || charVal == '2' || charVal == '3' || charVal == '4' || charVal == '5' || charVal == '6' || charVal == '7' || charVal == '8' || charVal == '9' || charVal == '/')
                    {
                        tempStr += charVal;
                    }
                }
                return tempStr;
            }

