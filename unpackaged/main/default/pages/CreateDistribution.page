        <script type="text/javascript">
        var popupStatus = 0;
                
                function InsufficientPermissions_Fancybox() 
                {
                    loadPopupnew('fancybox_background','InsufficientPermissions_Fancybox');
                    centerPopupnew('InsufficientPermissions_Fancybox');
                    document.getElementById('nocmtavilable').style.display = 'none';
                }
                
                function InsufficientPermissions_Fancybox1() 
                {
                    loadPopupnew('fancybox_background','InsufficientPermissions_Fancybox1');
                    centerPopupnew('InsufficientPermissions_Fancybox1');
                    document.getElementById('showerrorifamtisblank').style.display = 'none';
                }

                                                            
                function loadPopupnew(cid1,cid2)
                {
                    if(popupStatus==0){
                        $('.'+cid1).css({
                            "opacity": "0.5"
                        });
                        $('.'+cid1).fadeIn("slow");
                        $('.'+cid2).fadeIn("slow");
                        popupStatus = 1;
                    }
                };
                function centerPopupnew(cid)
                {
                    //request data for centering
                    var windowWidth = document.documentElement.clientWidth;
                    var windowHeight = document.documentElement.clientHeight;
                    var popupHeight = $('.'+cid).height();
                    var popupWidth = $('.'+cid).width();
                    //centering
                    $('.'+cid).css({
                        "position": "fixed",
                        "top": windowHeight/2-popupHeight/2,
                        "left": windowWidth/2-popupWidth/2
                    });
                };
                
                function closepopup(bgdivid,popupdivid)
                {
                    disablePopupnew(bgdivid);
                    $('.'+popupdivid).fadeOut("slow");
                } 
                
                function disablePopupnew(cid){
                    if(popupStatus==1){
                        $('.'+cid).fadeOut("slow");
                        popupStatus = 0;
                    }   
                };
        </script>
