<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PipelineOrFund</fullName>
    <active>true</active>
    <description>Either Pipeline or Fund Look up is selected at a time</description>
    <errorConditionFormula>OR(AND(Fund__c &lt;&gt;&quot;&quot;,Pipeline__c&lt;&gt;&quot;&quot;),AND(Fund__c =&quot;&quot;,Pipeline__c=&quot;&quot;))</errorConditionFormula>
    <errorMessage>Please select either a Pipeline or a Fund.</errorMessage>
</ValidationRule>
