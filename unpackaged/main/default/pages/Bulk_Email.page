                                <!--code is written for template grid Start -->
                                <table border="0" class="table">
                                    <tr width="100%">
                                        <td width="100%">
                                            <div style="margin:0 5px; border:1px solid #E9F2F7; border-top:none" class="margin_bottom_15px">
                                                <table cellpadding="0" cellspacing="0" border="0" class="table" style="table-layout: fixed; width: 100%">
                                                    <tr>
                                                        <td class="padding_none border_none">
                                                            <div style="width:auto;">
                                                                <span id="grid2"></span>
                                                            </div>
                                                               <!--Wait Cursor..Template-->
                                                            <div id="blurred_2" style="display:none; position:fixed; background-color:white; height:100%; width:100%; z-index:99999999; opacity:0.6; top:0; left:0;">
                                                                <div style="position:fixed; top:10%; left:38%; vertical-align:middle; height:auto; width:auto;"> 
                                                                </div>                     
                                                            </div>
                                                        </td>                                                         
                                                    </tr>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                </table>    
                                <!--code is written for template grid END-->
                            
                            </div><!-- Start Active Widget -->                 
                        </div><!-- Start Content Box -->
                        
                        <div style="margin:20px 24px;">
                            <div class="float_l"></div>
                            <div class="float_r">
                                <apex:commandLink styleClass="slds-button slds-button--neutral" title="Cancel" action="{!cancel}" value="Cancel"/>
                                <a class="slds-button slds-button--neutral click_for_step_1" href="" onclick="previousStep('second');" title="Previous">Previous</a>
                               <a class="slds-button slds-button--brand click_for_step_3" href="" onclick="nextPage('second');" title="Next">Next</a>                   
                            </div>
                            <div class="cl"></div>
                        </div>
                    </div>
                    <!-- End Step 2 -->
                
                
                
                   <!-- Start Step 3 -->
                    <div id="op3" class="step_3">             
                        <div class="content_div" style="padding:0;">
                            <apex:inputHidden value="{!sendingFailed}" id="Propcongrid"/>                        
                            <!--<apex:inputHidden value="{!fundId}" id="fndId"/> -->
                            <apex:inputHidden value="{!tempId}" id="tmpId"/>
                        </div>          
                        <div style="margin:20px 24px;">
                            <div class="float_l" style="line-height: 36px;">Step 3. Review and confirm</div>
                            <div class="float_r">                       
                                <apex:commandLink styleClass="slds-button slds-button--neutral" title="Cancel" action="{!cancel}" value="Cancel"/>                 
                                <a class="slds-button slds-button--neutral click_for_step_2" onclick="previousStep('third');" title="Previous">Previous</a>                     
                                <a id="btnstep3below" class="slds-button slds-button--brand click_for_step_4" href=""  onclick="checkmassmail();" title="Send">Send</a>                 
                            </div>
                            <div class="cl"></div>
                        </div>              
                        <!-- Start Content Box -->
                        <div class="ContentBox">                    
                            <span id="Nocontact" style="position:relative; top:4px;">You currently have 1 recipient(s) selected to receive this email.</span>
                            <h3 class="slds-section-title--divider" style="margin:10px 0 10px 0" >Processing Options</h3>                   
                            <table class="table" width="100%" cellpadding="5" cellspacing="0" style="margin-top:5px;">
                                <tbody>
                                    <tr>
                                        <td class="td1" width="250">BCC Me on One Message</td>
                                        <td class="td2">                                
                                            <label class="slds-checkbox"><apex:inputCheckbox id="IdbCC_Me_On_One" value="{!bCC_Me_On_One}" /><span class="slds-checkbox--faux"></span></label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="td1">Use My Signature</td>
                                        <td class="td2">                                
                                            <label class="slds-checkbox"><apex:inputCheckbox id="Iduse_My_Signature" value="{!use_My_Signature}" /><span class="slds-checkbox--faux"></span></label>
                                        </td>
                                    </tr>
                                     <tr>
                                        <td class="td1">Store an Activity for Each Message</td>                              
                                        <td class="td2">
                                            <label class="slds-checkbox"><apex:inputCheckbox id="IdchkStoreActivity" value="{!chkStoreActivity}" /><span class="slds-checkbox--faux"></span></label> 
                                        </td>
                                     </tr>                                                     
                                     <tr>
                                        <td>&nbsp;</td>
                                        <td>                                
                                            <span style="position:relative; top:-10px" class="mandatory_msg">
                                                <apex:outputPanel id="ol11" >
                                                    <apex:outputLabel id="ol22" style="color: #ff0000;font-family: Arial,Helvetica,sans-serif;font-size: 12px;line-height: 16px;" value="{!errormsgfrTrigger}" escape="false" >
                                                    </apex:outputLabel>
                                                </apex:outputPanel>                                 
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Start Content Box -->              
                        <div style="margin:20px 24px;">
                            <div class="float_l"></div>
                            <div class="float_r">                       
                                <apex:commandLink styleClass="slds-button slds-button--neutral" title="Cancel" action="{!cancel}" value="Cancel"/>
                                <a class="slds-button slds-button--neutral click_for_step_2" href="" onclick="previousStep('third');" title="Previous">Previous</a>
                                <a id="btnstep3below" class="slds-button slds-button--brand click_for_step_4" href=""  onclick="checkmassmail();" title="Send">Send</a>   
                                                    
                            </div>
                            <div class="cl"></div>
                        </div>
                    </div>
                    <!-- End Step 3 -->      
                    
                    
                    
                    <!-- Start Step 4 -->
                    <div id="op4" class="step_4">
                        <div style="margin:20px 24px;">
                            <div class="float_l" style="line-height: 36px;">Step 4. Your Emails Have Been Sent Successfully</div>
                            <div class="cl"></div>
                        </div>              
                         <div class="slds-box slds-theme--success" style="margin:0 24px;">
                            <p>
                                <apex:outputPanel id="SendMailCount">
                                    <img style="width:20px;" src="{!URLFOR($Resource.SLDS100, 'assets/icons/utility/notification_60_white.png')}"/>&nbsp;&nbsp;
                                    <b>Congratulations!</b> Your emails have been generated and emailed to the 
                                     {!MailCount} recipients you specified.
                                </apex:outputPanel>
                            </p>
                          </div>                
                        <div style="margin:20px 24px;">
                            <div class="float_l"></div>
                            <div class="float_r">                       
                                <apex:commandLink styleClass="slds-button slds-button--brand click_for_step_1" action="{!cancel}" value="Finished"/>
                            </div>
                            <div class="cl"></div>
                        </div>
                    </div>
                    <!-- End Step 4 -->               
                    
                    <br />

                    
                </div>
                 
            </body>
        </html>
    </apex:form>
</apex:page>