                                else
                                {
                                    var value = new Date(dateVal.replace(/-/g, "/"));
                                    try
                                    { 
                                        var dateOutput = DateUtil.getDateStringFromUserLocale(value); 
                                        obj.setCellText(dateOutput,j,parseInt(totalrowcount));                                 
                                    }
                                    catch(err)
                                    {
                                      alert("Create Data DateIndex Error.."+err);
                                    }
                                }
                            }
                        }
                        else if(arrcheckboxIndex.indexOf(j) > -1){
                            var imgs = "";
                            
                            if(arrAllFinalGridRecords[i][0] == null || arrAllFinalGridRecords[i][0] == ''){
                                if (arrAllFinalGridRecords[i][j].trim().toLowerCase() == 'true') {
                                    imgs = "<img style='margin-left: 40%; margin-top: 12px;' width='21' height='16' title='true' alt='Checked' src='{!URLFOR($Resource.PE_35,'PE_3.5/images/checkbox_checked_sf.gif')}'>";
                                } else {
                                    imgs += "<img style='margin-left: 40%; margin-top: 12px;' width='21' height='16' title='false' alt='Not Checked' src='{!URLFOR($Resource.PE_35,'PE_3.5/images/checkbox_sf.gif')}'>";
                                }
                                obj.setCellText(imgs,j,parseInt(totalrowcount));
                            }
                        }
                        else
                        {
                            var finaldata;
                            obj.setRowCount(arrAllFinalGridRecords.length);
                            finaldata = arrAllFinalGridRecords[i][j];                       
                            obj.setCellText(finaldata,j,parseInt(totalrowcount));
                            
                        }
                    }
                    totalrowcount = totalrowcount+1;
                }
            }
            obj.onSelectedRowsChanged = function(arrayOfRowIndices){
            window.status = arrayOfRowIndices;
            }
            obj.setControlImage("fontsize");
            obj.setControlValue("mixed");
            obj.setCellEditable(false);
            document.getElementById("grid").innerHTML = obj; 
            obj.setSortColumn(columnno); 
            obj.setSortDirection(colDirection,columnno); 
            
            obj.onCellMouseOver = function(event, column, row)
            {
                
                this.setCellTooltip(function(column, row) {
                
                    if (column > 0) 
                    {
                        var temp = document.createElement("pre");
                        if(getDateTypeColumn.indexOf(parseInt(column)) > -1)
                        {
                          temp.innerHTML = this.getCellText(column, row);
                        }
                        else

                        {                       
                         temp.innerHTML= this.getCellValue(column, row);

                        
                        }                       
                        if (temp.firstChild != null) return temp.firstChild.nodeValue;
                        else return "";
                    } 
                    else {
                        return "";
                    }
                });
            }
            obj.onHeaderClicked = function(event,column)
            {
                SortClicked=true;
                var headerName = getColumnName(column);
                var d_type= checkColumnDataType(column);
                
                if(headerName == Namespaceprefix1+'Fund__c')
                {
                    return 'disabled';
                }
                else if(d_type.toLowerCase() ==('multipicklist').toLowerCase())
                {
                     return 'disabled';
                } 
                else if(columnno==column)
                { 
                     showImz();
                    if(direction=='DESC NULLS LAST')
                    {
                        direction='ASC';
                       colDirection="ascending";
                    }  
                    else
                    {
                        direction='DESC NULLS LAST';
                        colDirection="descending";
                    }
                }
                else
                {      
                     direction='DESC NULLS LAST';
                     colDirection="descending";
                }
                document.getElementById('fcs').focus();
                document.getElementById('fcs').blur();
                
                ischeckLoadFlag = false;
                columnno=column;
                header_name_ofSort = MainGridFilds[column].split(':');
                executeQuery(MainGridFilds);
                showImz();
            }
            obj.refresh();
            hidePopup();
        }
        catch(err)
        {
            if(err.faultcode =='sf:INVALID_SESSION_ID')
            {
            
               sessionError(err);
              
            }
            else{
                 alert('Error : '+err);
            }
        }
    }
    </script>
    <!-- End Active Widget -->  

    <script>  
        window.addEventListener("load", onLoading(), false);
        setFocus = function() { return; }
    </script>
    
</apex:form>

