        // (SK: 1Nov2017)
        function HTMLEncode1(str)
        {
            str = str.split("amp;").join("");
            str = str.split("&#39;").join("'");
            var i = str.length,
            aRet = [];

            while (i--) 
            {
                var iC = str[i].charCodeAt();
                if (iC < 65 || iC > 127 || (iC>90 && iC<97)) 
                {
                    aRet[i] = '&#'+iC+';';
                } 
                else 
                {
                    aRet[i] = str[i];
                }
            }
            return aRet.join('');    
        }
        
        
        function wrenchsortarraydata{!componentID}(getarray,sortingcloumn,sortingdirection)
        {  
            if(sortingdirection=='ASC')
            {
                getarray.sort(function (a,b){
                    var x = a[sortingcloumn].toLowerCase(), y = b[sortingcloumn].toLowerCase();
                 
                    if (x > y) return  1;
                    if (x< y) return -1;
                    return 0;
                }); 
            }
            else{
              
                    getarray.sort(function (a,b) {
                    var x = a[sortingcloumn].toLowerCase(), y = b[sortingcloumn].toLowerCase();
                 
                    if (x< y) return  1;
                    if (x > y) return -1;
                    return 0;
                    }); 
                }  
                return getarray;
        }
        
        
