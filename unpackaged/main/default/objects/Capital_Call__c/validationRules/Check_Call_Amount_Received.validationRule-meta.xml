<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Call_Amount_Received</fullName>
    <active>true</active>
    <errorConditionFormula>if(Call_Amount_Received__c &lt;0,true,false)</errorConditionFormula>
    <errorDisplayField>Call_Amount_Received__c</errorDisplayField>
    <errorMessage>Call Amount Received cannot be less than zero.</errorMessage>
</ValidationRule>
