            // (SK: 2Nov2017)
            function HTMLEncode1(str)
            {
                str = str.split("amp;").join("");
                str = str.split("&#39;").join("'");
                var i = str.length,
                aRet = [];

                while (i--) 
                {
                    var iC = str[i].charCodeAt();
                    if (iC < 65 || iC > 127 || (iC>90 && iC<97)) 
                    {
                        aRet[i] = '&#'+iC+';';
                    } 
                    else 
                    {
                        aRet[i] = str[i];
                    }
                }
                return aRet.join('');    
            }
            
            function replaceSpecialChars(strToChange)
            {            
                try
                {                  
                    if(strToChange != null || strToChange != '')
                    {
                        return strToChange.replace('<br>','').replace('%','&#37;').replace(',','&#44;').replace('/','&#47;').replace('^','&#94;').replace('_','&#95;').replace('`','&#96;').replace('~','&#126;').replace('!','&#33;').replace('*','&#42;').replace('?','&#63;').replace(':','&#58;').replace('|','&#124;').replace('+','&#43;').replace('=','&#61;').replace('[','&#91;').replace(']','&#93;').replace('{','&#123;').replace('}','&#125;').replace('\'',' &#39;').replace('"','&quot').replace('\\','&#92;').replace('€','&#128;').replace('£','&#163;');                                             
                    }
                    else
                    {
                        return '';
                    }
                }
                catch(ex)
                { 
                return ''; 
                }
            }
            
