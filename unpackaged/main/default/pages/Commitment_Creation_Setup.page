                $(recRow).insertAfter('#'+passedId);
                strNameIds = 'PartnershipObjField'+partnershipLeftRowCount+'';          
                jQueryUtilityOfAutoComplete(strNameIds,strPartnershipList);

                columnIndexId = passedId.substring(23,passedId.length); 
             
