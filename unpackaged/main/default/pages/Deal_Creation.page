    //Used for update automatic value from legal name to pipeline name field.
    function updatepiPelineValue(val){      
        var monthNames = ["January", "February", "March", "April", "May", "June",
          "July", "August", "September", "October", "November", "December"
        ];      
        var current_date = new Date();
        var strMonthName = monthNames[current_date.getMonth()];
        var year_value = current_date.getFullYear();
        if(strMonthName.length>0){
            strMonthName = strMonthName.substring(0, 3);
