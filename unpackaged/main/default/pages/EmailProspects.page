        function gridsorting(sortingalpha,sortingdirection)
        {
            var getDataType = MainGridFilds[sortingalpha-1].split(':');
            try
            {   
                if(sortingalpha > 0 )
                sortingalpha = parseInt(sortingalpha) - 1;
                batchNo=0;        
                if(getDataType[3] == 'date' || getDataType[3] == 'datetime')
                {
                    if(sortingdirection == 'ASC')
                    {
                        allcontactrecords.sort(function (a,b) 
                        {
                            return globalSorting(a[sortingalpha],b[sortingalpha],'date','ASC');
                        }); 
                    }
                    else
                    {
                        allcontactrecords.sort(function (a,b) 
                        {
                            return globalSorting(a[sortingalpha],b[sortingalpha],'date','DESC');
                        });
                    }                       
                }
                else if(getDataType[3] == 'number' || getDataType[3] == 'currency' || getDataType[3] == 'percent')
                {
                    if(sortingdirection == 'ASC')
                    {
                        allcontactrecords.sort(function (a,b) 
                        {
                        return globalSorting(a[sortingalpha],b[sortingalpha],'number','ASC');
                        }); 
                    }
                    else
                    {
                        allcontactrecords.sort(function (a,b) 
                        {
                        return globalSorting(a[sortingalpha],b[sortingalpha],'number','DESC');
                        });
                    }
                }
                else
                {
                    if(sortingdirection == 'ASC')
                    {
                        allcontactrecords.sort(function (a,b) 
                        {
                            return globalSorting(a[sortingalpha],b[sortingalpha],'string','ASC');
                        }); 
                    }
                    else
                    {
                        allcontactrecords.sort(function (a,b) 
                        {
                        return globalSorting(a[sortingalpha],b[sortingalpha],'string','DESC');
                        });
                    }   
                }
                createdata(); 
            }
            catch(ex)
            {
                alert('gridsorting Error :'+ex); 
            }
        }
        
                
        
        function globalSorting(data1,data2,dataType,sortType)
        {
            if(dataType == 'date')
            {
                if((data1 == null || data1 == '') && (data2 == null || data2 == ''))
                {
                    return 0;
                }
                else if((data1 != null || data1 != '') && (data2 == null || data2 == '') )
                {
                    if(sortType == 'ASC')
                        return 1;
                    else
                        return -1;
                }
                else if((data2 != null || data2 != '') && (data1 == null || data1 == '') )
                {
                    if(sortType == 'ASC')
                        return -1;
                    else
                        return 1;
                }
                else
                {
                    if(sortType == 'ASC')
                        return new Date(data1) - new Date(data2);
                    else
                        return new Date(data2) - new Date(data1);
                }
            }
            else if(dataType == 'integer')
            {
                if((data1 == null || data1 == '') && (data2 == null || data2 == ''))
                {
                    return 0;
                }
                else if((data1 != null || data1 != '') && (data2 == null || data2 == '') )
                {
                    if(sortType == 'ASC')
                        return 1;
                    else
                        return -1;
                }
                else if((data2 != null || data2 != '') && (data1 == null || data1 == '') )
                {
                    if(sortType == 'ASC')
                        return -1;
                    else
                        return 1;
                }
                else
                {
                    var aparse = parseFloat(data1);
                    var bparse = parseFloat(data2);
                    if(sortType == 'ASC')
                        return aparse - bparse;
                    else
                        return bparse - aparse;
                }
            }
            else
            {
                if(sortType == 'ASC')
                {
                    if(data1 == null)
                    {
                        data1='';
                    }
                    if(data2 == null)
                    {
                        data2='';
                    }                        
                    var x = data1.toLowerCase();
                    var y = data2.toLowerCase();                        
                    if (x > y) return  1;
                    if (x < y) return -1;
                    return 0;
                }
                else
                {
                    var x = data1.toLowerCase();
                    var y = data2.toLowerCase();                        
                    if (x< y) return  1;
                    if (x> y) return -1;
                    return 0;
                }
            }
        }
        
