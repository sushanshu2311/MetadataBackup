                if(document.getElementById("rdbAmount").checked == true)
                {
                    var negativeVal = new Array();
                    var invalidVal = new Array();
                    
                    if(!isValidNumber('txtCapitalAmt'))
                        invalidVal.push('Capital Amount');
                    else if(!isNegativeNumber('txtCapitalAmt'))
                        negativeVal.push('Capital Amount');

                    if(!isValidNumber('txtManagementFeeAmt'))
                        invalidVal.push('Management Fee');
                    else if(!isNegativeNumber('txtManagementFeeAmt'))
