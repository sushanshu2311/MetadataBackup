        function search_flds{!componentID}()
        {    
            var searchtxt=document.getElementById('searchcon_grid1{!componentID}').value;
                    
            searchtxt=searchtxt.trim();
            if(searchtxt=="" || searchtxt==null)
            {
                //alert('Please enter a value.');
                $('#msgBlankId').text('Please enter a value.');
                return false;
            }
            else
            {
                $('#msgBlankId').val('');
                $('#msgBlankId').text('');
                deselectName{!componentID}('Current_Selected_Fields{!componentID}');
                deselectName{!componentID}('All_Available_Fields{!componentID}');
                resetAvailablelist{!componentID}();
                var len=localAvlArray{!componentID}.length; 
                    
                for (var count=len-1; count>=0; count--) 
                {    
                    if (localAvlArray{!componentID}[count][2].toLowerCase().indexOf(searchtxt.toLowerCase())==-1) 
                    {
                        localAvlArray{!componentID}.splice(count,1);
                    }
                }
                if(localAvlArray{!componentID}.length == 0)
                {
                    localAvlArray{!componentID}.push(['','','No match found.']);
                }
                createAvlSelList{!componentID}(localAvlArray{!componentID}); 
                                   
                document.getElementById('searchcon_grid1{!componentID}').value=searchtxt;
            } 
                          
        }
        
