                                            var aparsedate1;
                                            var bparsedate2;
                                            if((a[sortingalpha] == null || a[sortingalpha] == '' )
                                                && (b[sortingalpha] == null || b[sortingalpha] == ''))
                                            {
                                                return 0;
                                            }
                                            if(a[sortingalpha] != null && a[sortingalpha] != '')
                                            {
                                                aparsedate1 =new Date(a[sortingalpha].split('@')[0]);
                                            }
                                            else
                                            {
                                                return 1;
                                            }
                                            if(b[sortingalpha] != null && b[sortingalpha] != '')
                                            {
                                                bparsedate2 = new Date(b[sortingalpha].split('@')[0]);
                                            }
                                            else{
                                                return -1;
                                            }                       
                                            return  bparsedate2 - aparsedate1;
                                           // return new Date(b[sortingalpha]) - new Date(a[sortingalpha]);
                                        }
                                        else if(reportdatatypes[sortingalpha].toLowerCase().indexOf('currency') > -1 ||
                                        reportdatatypes[sortingalpha].toLowerCase().indexOf('double') > -1 ||
                                        reportdatatypes[sortingalpha].toLowerCase().indexOf('integer') > -1 ||
                                        reportdatatypes[sortingalpha].toLowerCase().indexOf('percent') > -1)
                                        {
                                            var aparse1;
                                            var bparse1;
                                            if((a[sortingalpha] == null || a[sortingalpha] == '' )
                                                && (b[sortingalpha] == null || b[sortingalpha] == ''))
                                            {
                                                return 0;
                                            }
                                            if(a[sortingalpha] != null && a[sortingalpha] != '')
                                            {
                                                aparse1 = parseFloat(a[sortingalpha].split(':')[1]);
                                            }
                                            else
                                            {
                                                return 1;
                                            }
                                            if(b[sortingalpha] != null && b[sortingalpha] != '')
                                            {
                                                bparse1 = parseFloat(b[sortingalpha].split(':')[1]);
                                            }
                                            else{
                                                return -1;
                                            }                       
                                            return bparse1 - aparse1;
                                        }
                                        else
                                        {
                                            var x = a[sortingalpha].toLowerCase();
                                            var y =b[sortingalpha].toLowerCase();
                                            
                                            if (x< y) return  1;
                                            if (x> y) return -1;
                                            return 0;
                                        }
                                    }); 
                                }
                                
                                if(isHeaderSorting == true || isHeaderSorting == 'true')
                                {
                                    createdata(); 
                                }
                            }
                            
                        }
                        catch(err)
                        {
                            document.getElementById('blurred').style.display = 'none';
                            document.getElementById('iderrordiv').innerHTML=err;
                            ErrorMessage();
                        }
                    }
                    
