                while(stringToMaintainSectionLeft.indexOf('@@') > -1)   /*Remove double occurance.*/
                    stringToMaintainSectionLeft = stringToMaintainSectionLeft.replace("@@", "@"); 
                if(stringToMaintainSectionLeft.substring(stringToMaintainSectionLeft.length -1 , stringToMaintainSectionLeft.length) == '@')     /*Remove Special Char from end.*/
                    stringToMaintainSectionLeft = stringToMaintainSectionLeft.substring(0, stringToMaintainSectionLeft.length - 1);
            }
            
            /*
            @Description: It will return updated array after insertion of new element at a left place.
            @Parameter1: passedStringOfArray; its string that holds positions occupied.
            @Parameter2: splitAfterChar; character after which new position needs to be insert.
            @Parameter3: insertChar; Character that needs to be inserted in between of an array.
            */
            function splitToPlaceNewCharInArrayJS(passedStringOfArray, insertAfterThisChar, insertingChar)
            {
                var arrOfTwoSplitTemp = passedStringOfArray.split('@');
                var arrOfTwoSplitTempUpdated = new Array();
                for(var i = 0; i < arrOfTwoSplitTemp.length; i++)
                {
                    if(arrOfTwoSplitTemp[i].toString() == insertAfterThisChar.toString() )
                    {
                        arrOfTwoSplitTempUpdated.push( arrOfTwoSplitTemp[i].toString() );                       
                        arrOfTwoSplitTempUpdated.push( insertingChar.toString() );                      
                    }
                    else
                    {
                        arrOfTwoSplitTempUpdated.push( arrOfTwoSplitTemp[i].toString() ); 
                    }
                }
                return arrOfTwoSplitTempUpdated.toString().replace( /,/g, "@" );
            }
            
            
            /*
            @Description: It will return updated array after removal of new element at a right place.
            @Parameter1: passedStringOfArray; its string that holds positions occupied.
            @Parameter2: removingChar; the character which needs to be removed from string.
            */
            function splitToRemoveCharFromArrayJS(passedStringOfArray, removingChar)
            {
                var arrOfTwoSplitTemp = passedStringOfArray.split('@');
                var arrOfTwoSplitTempUpdated = new Array();
                for(var i = 0; i < arrOfTwoSplitTemp.length; i++)
                {
                    if(arrOfTwoSplitTemp[i] != undefined && arrOfTwoSplitTemp[i].toString() == removingChar.toString() )
                    {
                        //Do Nothing in this case, for now.             
                    }
                    else if( arrOfTwoSplitTemp[i] != undefined )
                    {
                        arrOfTwoSplitTempUpdated.push( arrOfTwoSplitTemp[i].toString() ); 
                    }
                }
                return arrOfTwoSplitTempUpdated.toString().replace( /,/g, "@" );
            }
            
            
