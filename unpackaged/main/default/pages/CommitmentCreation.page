                            errorIdArray.push('ComtAmtErrInvalidId');
                          }
                         if(dateValueError == 'block')
                         {
                             errorIdArray.push('ComtDateErrId');
                         }
                         if(dateValueInvalidError == 'block')
                         {
                            errorIdArray.push('ComtDateInvalidErrId');
                         }
                         arryCommitmentError[i] = errorIdArray;
                         if(editIconLP == 'block')
                         {
                             var editIcon = 'LPEdit'+i;
                             editIconId.push(editIcon); 
                         }
                         if(editIconPT == 'block')
                         {
                             var editIcon = 'PTEdit'+i;
                             editIconId.push(editIcon);
                         }
                     }
                     
                     
                     document.getElementsByClassName('LPInput'+i)[0].value = '';
                     document.getElementsByClassName('PTInput'+i)[0].value = '';
                     document.getElementsByClassName('ComtAmountId'+i)[0].value = '';
                     document.getElementsByClassName('ComtDateId'+i)[0].value = '';
                     
                     
                 }
                 
                 
             }
             
            }
            
            function gettingCommitmentData()
            { 
             var creationTable = document.getElementById('CommitmentTableSection');
             var tableRowCount = creationTable.rows.length;
             var returnValue = false;
             for(var i=0;i<tableRowCount;i++)
             {
                 var rowId = 'row'+i;
                 var checkRowId = document.getElementById('row'+i);
                 if(checkRowId == null && arrayDeletedRowId.indexOf(rowId) != -1)
                 {
                     tableRowCount++;
                 }
                 else
                 {
                     
                     var arryRowData = arryComtRowData[rowId];
                     if(arryRowData != undefined)
                     {                    
                         document.getElementsByClassName('LPInput'+i)[0].value = arryRowData["limited_partner"] ;
                         document.getElementsByClassName('PTInput'+i)[0].value = arryRowData["Partnership"];
                         document.getElementsByClassName('ComtAmountId'+i)[0].value = arryRowData["comtAmount"];
                         document.getElementsByClassName('ComtDateId'+i)[0].value = arryRowData["comtDate"];
                     }
                     var errorRowData = arryCommitmentError[i];
                     if(errorRowData != undefined && errorRowData != '')
                     {
                         for(var j=0;j<errorRowData.length;j++)
                         {
                             showErrorMessage(i,errorRowData[j]);
                         }
                         
                     }
                     
                     if(editIconId != undefined && editIconId.length != 0)
                     {
                         for(var k=0;k<editIconId.length;k++)
                         {
                             document.getElementById(editIconId[k]).style.display = 'block';
                         }
                         
                     }
                     
                     
                 }
                 
                 
             }
             
            }       
            
            function clearAllErrorMsg(divClassName)
            {
                $("."+divClassName).find("div.errorMsg").css({"display": "none"});
                document.getElementById("{!$Component.CommitmentCreationFormId.LPPageMsg}").innerHTML ='';
                document.getElementById("{!$Component.CommitmentCreationFormId.PTPageMsg}").innerHTML = '';
                
            }
            
            function keyPressFunction(ImageId,rowId,element,keyEvent)
            {
                var editImageId = ImageId+rowId;
                var popupDisplay;
                if(element.value != '' && element.value != null)
                {  var recordIdExists
                if(ImageId =='LPEdit')
                {
                    recordIdExists  = getLPRecordId(rowId);
                    popupDisplay = isLimitedPartner;
                }
                 else if(ImageId == 'PTEdit')
                 {
                     recordIdExists  = getPartnershipRecordId(rowId);
                     popupDisplay = isPartnership;
                 }
                 if(recordIdExists == '' && (popupDisplay == true || popupDisplay == 'true'))
                 {
                     autoCompleteSelected = false;
                     document.getElementById(editImageId).style.display = 'block';
                 }
                 else
                 {
                     autoCompleteSelected = true;
                     document.getElementById(editImageId).style.display = 'none';
                 }
                }
                else
                {
                    autoCompleteSelected = true;
                    document.getElementById(editImageId).style.display = 'none';
                }          
                
                
            }
            </script>
            <apex:outputPanel id="autoCompletePanelId"> 
                <script type="text/javascript">
                
                var apexAccountList =[];
                var apexPartnarshipList =[];
                
                function getLPRecordId(rowId)
                {
                    var recordId = ''; 
                    var lpRowData = document.getElementsByClassName('LPInput'+rowId)[0].value;
                    <apex:repeat value="{!lstFieldLabelVsApi}" var="LPLst">
                        var LPLstName =  "{!JSENCODE(LPLst.Name)}";       
                    if(LPLstName == lpRowData)
                    {
                        recordId = "{!LPLst.id}";
                        
                    }                                
                    </apex:repeat>    
                    return recordId;
                }   
                
                function getPartnershipRecordId(rowId)
                {
                    var recordId = ''; 
                    var ptRowData = document.getElementsByClassName('PTInput'+rowId)[0].value;
                    <apex:repeat value="{!lstPartnershipLabel}" var="PTLst">
                        var PTLstName = "{!JSENCODE(PTLst.Name)}";      
                    if(PTLstName == ptRowData)
                    {
                        recordId = "{!PTLst.Id}";
                    }                                
                    </apex:repeat>
                    
                    return recordId;
                }  
                <apex:repeat value="{!lstFieldLabelVsApi}" var="LPLst">            
                    apexAccountList.push("{!JSENCODE(LPLst.name)}");                              
                </apex:repeat>
                
                
                <apex:repeat value="{!lstPartnershipLabel}" var="PTLst">            
                    apexPartnarshipList.push("{!JSENCODE(PTLst.name)}");                           
                </apex:repeat>
                
                
                </script>
